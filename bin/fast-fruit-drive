DAV_URI = f"dav://{WEBDAV_USER}@{DAV_HOST}:{PORT}/"
LEGACY_URI_NO_USER = f"dav://{DAV_HOST}:{PORT}/"
LEGACY_URI_OLD_HOST_AUTH = f"dav://{WEBDAV_USER}@{BIND_V4}:{PORT}/"
LEGACY_URI_OLD_HOST = f"dav://{BIND_V4}:{PORT}/"

CACHE_SIZE_CHOICES = ("512M", "1G", "2G", "4G", "8G", "16G")
DEFAULT_CACHE_MAX_SIZE = "4G"
DEFAULT_CACHE_MAX_AGE_HOURS = 24
MIN_CACHE_MAX_AGE_HOURS = 1
MAX_CACHE_MAX_AGE_HOURS = 168

OUTPUT_CAP = 65536
STATUS_TIMEOUT = 12.0
CONTROL_TIMEOUT = 40.0
