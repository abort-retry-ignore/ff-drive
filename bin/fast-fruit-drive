# =======================================================================

def write_unit() -> None:
    d = ensure_state_dir(rel_to_home(UNIT_DIR))
    try:
        unit = f"""\
[Unit]
Description=Fast Fruit Drive \u2014 rclone iCloud WebDAV for Nautilus
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart={SELF_PATH} serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group
Environment=PATH=/usr/bin
UnsetEnvironment=BASH_ENV ENV PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONINSPECT LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GIO_EXTRA_MODULES GI_TYPELIB_PATH GSETTINGS_BACKEND GIO_USE_VFS
NoNewPrivileges=yes
UMask=0077
LimitNOFILE=65536
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={CACHE_DIR}
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
SyslogIdentifier={APP}

[Install]
WantedBy=default.target
"""
        d.atomic_write(UNIT_NAME, unit.encode("utf-8"), 0o644)
    finally:
        d.close()
    if not Tools.systemctl:
        fail("systemctl not found")
    run_bounded([Tools.systemctl, "--user", "daemon-reload"], timeout=10)
    run_bounded([Tools.systemctl, "--user", "enable", UNIT_NAME], timeout=10)


def rewrite_bookmarks(append: "str | None") -> None:
    d = ensure_state_dir(rel_to_home(BOOKMARKS_DIR))
    try:
        existing = d.read_bounded("bookmarks", 1_048_576, missing_ok=True)
        lines = existing.decode("utf-8", "replace").splitlines() if existing else []
        drop_prefixes = (DAV_URI, LEGACY_URI_NO_USER, LEGACY_URI_OLD_HOST_AUTH, LEGACY_URI_OLD_HOST)
        keep = [
            line for line in lines
            if not (line.startswith("dav://") and (
                "iCloud Drive" in line or "iCloud WebDAV" in line
                or line.startswith(drop_prefixes)))
        ]
        if append:
            keep.append(append)
        data = ("\n".join(keep) + "\n").encode("utf-8", "replace") if keep else b""
        d.atomic_write("bookmarks", data, 0o600)
    finally:
        d.close()


def ensure_bookmark() -> None:
    rewrite_bookmarks(f"{DAV_URI} {DISPLAY_NAME}")


def remove_bookmark() -> None:
    rewrite_bookmarks(None)


def install_nautilus_extension() -> None:
    if not os.path.isfile(NAUTILUS_SOURCE):
        return
    try:
        with open(NAUTILUS_SOURCE, "rb") as fh:
            src_st = os.fstat(fh.fileno())
            if not stat.S_ISREG(src_st.st_mode) or src_st.st_size > 2_097_152:
                fail("refusing to install oversized Nautilus extension source")
            data = fh.read(2_097_153)
            if len(data) > 2_097_152:
                fail("refusing to install oversized Nautilus extension source")
    except OSError as exc:
        fail(f"cannot read Nautilus extension source: {exc}")

    d = ensure_state_dir(rel_to_home(EXTENSION_DIR))
    try:
        existing = d.read_bounded("fast_fruit_drive_nautilus.py", 2_097_152, missing_ok=True)
        if existing == data:
            return
        d.atomic_write("fast_fruit_drive_nautilus.py", data, 0o644)
    finally:
        d.close()


def remove_nautilus_extension() -> None:
    d = open_state_dir(rel_to_home(EXTENSION_DIR))
    if d is None:
        return
    try:
        d.unlink("fast_fruit_drive_nautilus.py")
        try:
            pycache = d.enter("__pycache__")
        except (FileNotFoundError, Unsafe):
            return
        try:
            for entry in list(pycache.scandir_names()):
                if entry.name.startswith("fast_fruit_drive_nautilus"):
                    pycache.unlink(entry.name)
        finally:
            pycache.close()
    finally:
        d.close()


# =======================================================================
# Pending-upload protection
#
# clear-cache and uninstall both delete the local VFS cache. rclone tracks
# not-yet-uploaded writes in vfsMeta/<remote>/... with "Dirty": true; that
# state must never be deleted before the upload finishes. The scan below
# is descriptor-relative and bounded (depth, entry count, per-file size),
# exactly like every other tree walk in this file.
# =======================================================================

MAX_META_ENTRIES = 200_000
MAX_META_DEPTH = 64
MAX_META_FILE = 262_144


def _scan_dirty(d: SafeDir, depth: int, counter: list) -> bool:
    if depth > MAX_META_DEPTH:
        raise Unsafe("cache metadata tree too deep")
    for entry in d.scandir_names():
        counter[0] += 1
        if counter[0] > MAX_META_ENTRIES:
            raise Unsafe("cache metadata tree too large")
        if entry.is_dir(follow_symlinks=False):
            child = d.enter(entry.name)
            try:
                if _scan_dirty(child, depth + 1, counter):
                    return True
            finally:
                child.close()
            continue
        if not entry.is_file(follow_symlinks=False):
            continue
        try:
            data = d.read_bounded(entry.name, MAX_META_FILE, missing_ok=True)
        except Unsafe:
            continue
        if not data:
            continue
        try:
            obj = json.loads(data)
        except ValueError:
            continue
        if isinstance(obj, dict) and obj.get("Dirty") is True:
            return True
    return False


def cache_has_dirty_uploads() -> bool:
    cache = open_state_dir(rel_to_home(CACHE_DIR))
    if cache is None:
        return False
    try:
        try:
            meta_root = cache.enter("vfsMeta")
        except (FileNotFoundError, Unsafe):
            return False
        try:
            return _scan_dirty(meta_root, 0, [0])
        finally:
            meta_root.close()
    finally:
        cache.close()


def cache_bytes() -> int:
    total = 0
    cache = open_state_dir(rel_to_home(CACHE_DIR))
    if cache is None:
        return 0
    try:
        stack = [cache]
        opened_extra = []
        while stack:
            cur = stack.pop()
            for entry in cur.scandir_names():
                try:
                    if entry.is_dir(follow_symlinks=False):
                        child = cur.enter(entry.name)
                        opened_extra.append(child)
                        stack.append(child)
                    elif entry.is_file(follow_symlinks=False):
                        total += entry.stat(follow_symlinks=False).st_size
                except (OSError, Unsafe):
                    continue
        for d in opened_extra:
            d.close()
    finally:
        cache.close()
    return total


# =======================================================================
# systemctl / gio helpers
# =======================================================================

def service_main_pid() -> "int | None":
    if not Tools.systemctl:
        return None
    result = run_bounded([Tools.systemctl, "--user", "show", "-p", "MainPID", "--value", UNIT_NAME], timeout=5)
    if not result.ok:
        return None
    text = result.stdout.decode("ascii", "replace").strip()
    if not text.isdigit():
        return None
    pid = int(text)
    return pid if pid > 1 else None


def service_running() -> bool:
    if not Tools.systemctl:
        return False
    result = run_bounded([Tools.systemctl, "--user", "is-active", "--quiet", UNIT_NAME], timeout=5)
    return result.returncode == 0 and not result.timed_out


def systemctl(*args: str, timeout: float = 20) -> BoundedResult:
    if not Tools.systemctl:
        fail("systemctl not found")
    return run_bounded([Tools.systemctl, "--user", *args], timeout=timeout)


def gio_mounted() -> bool:
    if not Tools.gio:
        return False
    result = run_bounded([Tools.gio, "mount", "-l"], timeout=5)
    return DAV_URI in result.stdout.decode("utf-8", "replace")


def label_mount() -> None:
    if not Tools.gio:
        return
    run_bounded([Tools.gio, "set", "-t", "string", DAV_URI, "metadata::display-name", DISPLAY_NAME], timeout=5)


def unmount_legacy_dav() -> None:
    if not Tools.gio:
        return
    for uri in (LEGACY_URI_NO_USER, LEGACY_URI_OLD_HOST_AUTH, LEGACY_URI_OLD_HOST):
        run_bounded([Tools.gio, "mount", "-u", uri], timeout=5)


def unmount_dav() -> None:
    if not Tools.gio:
        return
    run_bounded([Tools.gio, "mount", "-u", DAV_URI], timeout=5)
    unmount_legacy_dav()


# =======================================================================
# Commands
# =======================================================================

def require_packages() -> None:
    need_rclone = not Tools.rclone
    need_gvfs = not (os.path.isfile("/usr/lib/gvfsd-dav") and os.access("/usr/lib/gvfsd-dav", os.X_OK))
    if not need_rclone and not need_gvfs:
        return
    lines = [f"{APP}: required packages missing. Run: omarchy pkg add gvfs-dnssd rclone"]
    if need_rclone:
        lines.append("  - rclone \u2014 serves iCloud over WebDAV")
    if need_gvfs:
        lines.append("  - gvfs-dnssd \u2014 the Nautilus WebDAV backend")
    lines.append("Then toggle Fast Fruit Drive on again.")
    print("\n".join(lines), file=sys.stderr)
    raise SystemExit(1)


def cmd_ensure(_args) -> None:
    require_packages()
    cfg = load_config()
    save_config(cfg)
    # ReadWritePaths= in the unit below needs this directory to already
    # exist: systemd sets up the bind mount before ExecStart runs, and
    # ProtectHome=read-only would otherwise leave a fresh install with no
    # way to create it from inside the sandboxed service.
    ensure_state_dir(rel_to_home(CACHE_DIR)).close()
    ensure_webdav_auth()
    write_unit()
    ensure_bookmark()
    install_nautilus_extension()


def cmd_serve(_args) -> None:
    cfg = load_config()
    if not Tools.rclone:
        fail("rclone not found")
    if not remote_configured():
        fail(f"rclone remote '{REMOTE}' is not configured")
    ensure_state_dir(rel_to_home(CACHE_DIR)).close()
    # Open the config dir with a fd that survives the coming execve, so
    # rclone can be handed "/proc/self/fd/N/webdav.htpasswd" — a path that
    # cannot be swapped later because it resolves through the retained
    # open directory description, not by re-walking a pathname.
    authdir = ensure_state_dir(rel_to_home(CONFIG_DIR))
    os.set_inheritable(authdir.fd, True)
    try:
        validate_webdav_auth(authdir)
    except AuthError as exc:
        fail(str(exc))
    args = [
        Tools.rclone, "serve", "webdav", REMOTE,
        "--addr", f"{BIND_V4}:{PORT}",
        "--addr", f"[{BIND_V6}]:{PORT}",
        "--vfs-cache-mode", VFS_CACHE_MODE,
        "--vfs-cache-max-size", cfg.cache_max_size,
        "--vfs-cache-max-age", cfg.cache_max_age,
        "--vfs-read-ahead", "0",
        "--poll-interval", "0",
        "--dir-cache-time", "30s",
        "--cache-dir", CACHE_DIR,
        "--htpasswd", f"/proc/self/fd/{authdir.fd}/{WEBDAV_HTPASSWD_FILE}",
    ]
    os.execve(Tools.rclone, args, sanitized_child_env())


def wait_for_server() -> None:
    pid = service_main_pid()
    if pid is None:
        fail("service MainPID unavailable")
    if not Tools.rclone:
        fail("rclone not found")
    wait_webdav_ready(pid, Tools.rclone)


def do_mount() -> None:
    pid = service_main_pid()
    if pid is None:
        fail("service MainPID unavailable")
    if not Tools.rclone:
        fail("rclone not found")
    unmount_legacy_dav()
    mount_dav(pid, Tools.rclone)
    label_mount()


def cmd_start(_args) -> None:
    cmd_ensure(_args)
    if not remote_configured():
        fail(f"rclone remote '{REMOTE}' is not configured \u2014 use Sign in on the widget")
    if not session_present():
        fail("iCloud session missing or expired \u2014 use Sign in on the widget")
    systemctl("start", UNIT_NAME)
    if not service_running():
        fail(f"service failed to start \u2014 see: journalctl --user -u {UNIT_NAME}")
    wait_for_server()
    do_mount()
    ensure_bookmark()


def cmd_stop(_args) -> None:
    unmount_dav()
    systemctl("stop", UNIT_NAME, timeout=20)
    remove_bookmark()


def _guard_no_dirty(action: str) -> bool:
    """Stop the service, refuse if pending uploads exist (restarting the
    service first), otherwise leave it stopped. Returns whether it was
    running before this call."""
    was_running = service_running()
    if was_running:
        systemctl("stop", UNIT_NAME, timeout=20)
    if cache_has_dirty_uploads():
        if was_running:
            systemctl("start", UNIT_NAME, timeout=20)
        fail(f"pending uploads remain in the local cache \u2014 wait for them to finish, then {action} again")
    return was_running


def cmd_restart(_args) -> None:
    cmd_ensure(_args)
    systemctl("restart", UNIT_NAME)
    wait_for_server()
    do_mount()
    ensure_bookmark()


def cmd_toggle(args) -> None:
    if service_running():
        cmd_stop(args)
    else:
        cmd_start(args)


def cmd_open(_args) -> None:
    load_config()
    if Tools.omarchy:
        spawn_detached([Tools.omarchy, "launch", "nautilus"])
    elif Tools.nautilus:
        spawn_detached([Tools.nautilus, "--new-window"])
    else:
        fail("nautilus not found")
    if not service_running():
        cmd_start(_args)
        return
    do_mount()
    ensure_bookmark()


def cmd_login(_args) -> None:
    if Tools.omarchy:
        spawn_detached([Tools.omarchy, "launch", "tui",
                         "--app-id=io.github.abort-retry-ignore.ff-drive-login",
                         Tools.python3 or sys.executable, "-I", SELF_PATH, "login-tui"])
        return
    if Tools.xdg_terminal:
        spawn_detached([Tools.xdg_terminal, "-e", Tools.python3 or sys.executable, "-I", SELF_PATH, "login-tui"])
        return
    fail(f"open a terminal and run: {SELF_PATH} login-tui")


def cmd_login_tui(_args) -> None:
    if not Tools.rclone:
        fail("rclone not found")
    print()
    print("Fast Fruit Drive \u2014 iCloud sign-in")
    print()
    print("rclone stores a trust token in ~/.config/rclone/rclone.conf (not in this plugin).")
    print("The token lasts about 30 days. After that, run Sign in again.")
    print("Use your real Apple ID password + 2FA. App-specific passwords are rejected.")
    print()
    if remote_configured():
        print(f"Reconnecting existing remote: {REMOTE}")
        print()
        subprocess.run([Tools.rclone, "config", "reconnect", REMOTE], env=sanitized_child_env())
    else:
        print(f"No '{REMOTE}' remote yet. In the rclone wizard:")
        print("  n) New remote")
        print(f"  name> {REMOTE_NAME}")
        print("  Storage> iclouddrive")
        print()
        subprocess.run([Tools.rclone, "config"], env=sanitized_child_env())
    print()
    print("Done. You can close this terminal. Toggle Fast Fruit Drive on from the bar.")
    print()


def cmd_configure(args) -> None:
    cfg = load_config()
    restart = False
    changed = False
    for pair in args:
        key, _, value = pair.partition("=")
        if key == "cache_max_size":
            if not valid_cache_size(value):
                fail(f"invalid cache_max_size: {value}")
            changed = changed or value != cfg.cache_max_size
            cfg.cache_max_size = value
        elif key == "cache_max_age_hours":
            if not valid_cache_age_hours(value):
                fail(f"invalid cache_max_age_hours: {value}")
            changed = changed or int(value) != cfg.cache_max_age_hours
            cfg.cache_max_age_hours = int(value)
        elif key == "restart":
            restart = bool_value(value)
        else:
            fail(f"unknown configure key: {key}")
    save_config(cfg)
    if restart and changed and service_running():
        cmd_restart(args)
    else:
        ensure_bookmark()


def cmd_clear_cache(_args) -> None:
    freed = cache_bytes()
    was_running = _guard_no_dirty("clear-cache")
    home = open_home()
    try:
        home.remove_tree(rel_to_home(CACHE_DIR))
    except (Unsafe, OSError) as exc:
        if was_running:
            systemctl("start", UNIT_NAME, timeout=20)
        fail(f"refusing to clear unsafe cache path: {exc}")
    finally:
        home.close()
    ensure_state_dir(rel_to_home(CACHE_DIR)).close()
    if was_running:
        systemctl("start", UNIT_NAME, timeout=20)
        wait_for_server()
    freed_text = _format_bytes(freed)
    print(f"Cache cleared: {freed_text} freed from {CACHE_DIR}")


def _format_bytes(n: int) -> str:
    value = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if value < 1000 or unit == "TB":
            return f"{value:.0f}{unit}" if unit == "B" else f"{value:.1f}{unit}"
        value /= 1000
    return f"{value:.1f}TB"


def cmd_uninstall(_args) -> None:
    was_running = _guard_no_dirty("uninstall")
    unmount_dav()
    if Tools.systemctl:
        run_bounded([Tools.systemctl, "--user", "disable", "--now", UNIT_NAME], timeout=20)
    d = open_state_dir(rel_to_home(UNIT_DIR))
    if d is not None:
        try:
            d.unlink(UNIT_NAME)
        finally:
            d.close()
    d = open_state_dir(rel_to_home(WANTS_DIR))
    if d is not None:
        try:
            d.unlink(UNIT_NAME)
        finally:
            d.close()
    if Tools.systemctl:
        run_bounded([Tools.systemctl, "--user", "reset-failed", UNIT_NAME], timeout=10)
        run_bounded([Tools.systemctl, "--user", "daemon-reload"], timeout=10)
    remove_bookmark()
    remove_nautilus_extension()
    home = open_home()
    try:
        try:
            home.remove_tree(rel_to_home(CONFIG_DIR))
        except (Unsafe, OSError) as exc:
            print(f"{APP}: refusing to delete unsafe path: {CONFIG_DIR} ({exc})", file=sys.stderr)
        try:
            home.remove_tree(rel_to_home(CACHE_DIR))
        except (Unsafe, OSError) as exc:
            print(f"{APP}: refusing to delete unsafe path: {CACHE_DIR} ({exc})", file=sys.stderr)
    finally:
        home.close()
    print(f"{APP}: removed unit, bookmark, emblems, {CONFIG_DIR}, and {CACHE_DIR}")
    print(f"{APP}: left ~/.config/rclone/rclone.conf untouched (Apple session is rclone's)")
    _ = was_running  # already stopped; nothing left to restart


def cmd_status(_args) -> None:
    cfg = load_config()
    rclone_found = bool(Tools.rclone)
    configured = rclone_found and remote_configured()
    has_session = configured and session_present()
    running = service_running()
    mounted = gio_mounted()
    gvfs = os.path.isfile("/usr/lib/gvfsd-dav") and os.access("/usr/lib/gvfsd-dav", os.X_OK)
    used = cache_bytes()

    ready = rclone_found and configured and has_session and gvfs
    needs_login = rclone_found and (not configured or not has_session)

    status_text = "Stopped"
    if not rclone_found:
        status_text = "rclone not found"
    elif needs_login:
        status_text = "Sign in to iCloud"
    elif not gvfs:
        status_text = "install gvfs-dnssd"
    elif running:
        status_text = "Connected" if mounted else "Serving"

    payload = {
        "ok": True,
        "ready": ready,
        "running": running,
        "mounted": mounted,
        "rcloneFound": rclone_found,
        "remoteConfigured": configured,
        "hasSession": has_session,
        "needsLogin": needs_login,
        "gvfsDav": gvfs,
        "cacheUsedBytes": used,
        "statusText": status_text,
        "remote": REMOTE,
        "addr": f"{BIND_V4}:{PORT}",
        "uri": DAV_URI,
        "displayName": DISPLAY_NAME,
        "cacheMaxSize": cfg.cache_max_size,
        "cacheMaxAge": cfg.cache_max_age,
        "cachePath": CACHE_DIR,
        "lastError": "",
    }
    print(json.dumps(payload))


USAGE = f"""Usage: {APP} <command> [args]

Commands:
  status                         JSON status for the bar widget
  start                          Start WebDAV, mount, bookmark as iCloud Drive
  stop                           Stop WebDAV and unmount
  restart                        Restart the user service
  toggle                         Start if stopped, stop if running
  open                           Start if needed and open in Nautilus
  login                          Open a terminal for iCloud sign-in / reconnect
  login-tui                      Interactive rclone reconnect (run inside a terminal)
  serve                          Exec rclone (systemd ExecStart)
  ensure                         Write unit, config, and Nautilus bookmark
  configure KEY=VAL [...]        Update config; add restart=1 to bounce rclone
  clear-cache                    Bounce rclone and wipe the local file cache
                                  (refuses while uploads are still pending)
  uninstall                      Stop and delete unit, bookmark, emblems, config, cache
                                  (refuses while uploads are still pending)
  help                           Show this help
"""


def cmd_help(_args) -> None:
    print(USAGE, end="")


def cmd_supervise(args) -> None:
    """QML entry point: run COMMAND ARGS... as an isolated child, capping
    its raw stdout/stderr in bytes *before* any line parsing happens, and
    enforcing a hard wall-clock deadline. Never used for `serve` (the
    long-running systemd service) or `login-tui` (an interactive session)."""
    if len(args) < 2:
        fail("usage: __supervise TIMEOUT COMMAND [ARGS...]")
    try:
        timeout = float(args[0])
    except ValueError:
        fail("invalid supervise timeout")
    command = args[1]
    if command not in SUPERVISABLE_COMMANDS:
        fail(f"refusing to supervise command: {command}")
    python3 = Tools.python3 or find_verified("python3")
    if not python3:
        fail("python3 not found")
    child_argv = [python3, "-I", SELF_PATH, command, *args[2:]]
    result = run_bounded(child_argv, timeout=timeout, cap=OUTPUT_CAP)
    sys.stdout.buffer.write(result.stdout)
    sys.stderr.buffer.write(result.stderr)
    if result.timed_out:
        sys.stderr.write(f"\n{APP}: command timed out after {timeout:g}s\n")
        raise SystemExit(124)
    if result.overflowed:
        sys.stderr.write(f"\n{APP}: command output exceeded {OUTPUT_CAP} bytes\n")
        raise SystemExit(125)
    raise SystemExit(result.returncode)


COMMANDS = {
    "status": cmd_status,
    "start": cmd_start,
    "stop": cmd_stop,
    "restart": cmd_restart,
    "toggle": cmd_toggle,
    "open": cmd_open,
    "login": cmd_login,
    "login-tui": cmd_login_tui,
    "serve": cmd_serve,
    "ensure": cmd_ensure,
    "configure": cmd_configure,
    "clear-cache": cmd_clear_cache,
    "uninstall": cmd_uninstall,
    "help": cmd_help,
}


def main(argv: "list[str]") -> None:
    command = argv[0] if argv else "help"
    rest = argv[1:]
    if command == "__supervise":
        resolve_tools()
        cmd_supervise(rest)
        return
    if command not in COMMANDS:
        fail(f"unknown command: {command}")
    if command == "serve":
        global _EXTRA_TRUSTED_UIDS
        _EXTRA_TRUSTED_UIDS = frozenset({_overflow_uid()})
    if command != "help":
        resolve_tools()
    COMMANDS[command](rest)


if __name__ == "__main__":
    main(sys.argv[1:])
