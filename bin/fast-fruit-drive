HERE = os.path.dirname(os.path.realpath(__file__))
SELF_PATH = os.path.join(HERE, os.path.basename(__file__))
PLUGIN_DIR = os.path.dirname(HERE)
NAUTILUS_SOURCE = os.path.join(PLUGIN_DIR, "nautilus", "fast_fruit_drive_nautilus.py")

PUBLIC_COMMANDS = (
    "status", "start", "stop", "restart", "toggle", "open",
    "login", "login-tui", "serve", "ensure", "configure",
    "clear-cache", "uninstall", "help",
)
# serve (systemd's long-running ExecStart) and login-tui (an interactive
# terminal session) must never be time-boxed or byte-capped by __supervise.
SUPERVISABLE_COMMANDS = frozenset(PUBLIC_COMMANDS) - {"serve", "login-tui", "help"}


def fail(message: str) -> "None":
    print(f"{APP}: {message}", file=sys.stderr)
    raise SystemExit(1)


def bool_value(value: str) -> bool:
    return value.strip().lower() in ("1", "true", "yes", "on")


def home_dir() -> str:
    return pwd.getpwuid(os.getuid()).pw_dir


HOME = home_dir()
CONFIG_DIR = os.path.join(HOME, ".config", APP)
CACHE_DIR = os.path.join(HOME, ".cache", APP)
UNIT_DIR = os.path.join(HOME, ".config", "systemd", "user")
WANTS_DIR = os.path.join(UNIT_DIR, "default.target.wants")
BOOKMARKS_DIR = os.path.join(HOME, ".config", "gtk-3.0")
RCLONE_CONF_DIR = os.path.join(HOME, ".config", "rclone")
EXTENSION_DIR = os.path.join(HOME, ".local", "share", "nautilus-python", "extensions")


# =======================================================================
# Descriptor-relative state handling
#
# Every path component is opened with O_NOFOLLOW relative to an already
# -open, already-validated parent directory descriptor. Validation and use
# happen in the same os.open() call, so there is no window between
# "check" and "use" for a symlink swap to exploit. Writes are atomic
# (O_EXCL temp file + rename, both relative to the same retained fd).
# =======================================================================

class Unsafe(RuntimeError):
    """A path, owner, or permission did not match what we require."""


def _overflow_uid() -> int:
    try:
        with open("/proc/sys/kernel/overflowuid", encoding="ascii") as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return 65534


# Only ever set for the sandboxed 'serve' entry point (see cmd_serve/main).
# systemd applies an unprivileged user namespace to satisfy ProtectSystem=
# strict/ProtectHome=read-only for --user units: our own uid maps through
# unchanged, but every other uid (including root) is remapped to the
# kernel's overflow uid, because it has no mapping inside that namespace.
# The sandbox itself (read-only /usr and /home, closed PATH, no shell,
# NoNewPrivileges) already provides the guarantee the ownership check
# exists for, so 'serve' additionally trusts the overflow uid as standing
# in for root. No other command runs under this sandbox, so no other
# command relaxes this check.
_EXTRA_TRUSTED_UIDS: frozenset = frozenset()


def _trusted_uids() -> frozenset:
    return frozenset({0, os.getuid()}) | _EXTRA_TRUSTED_UIDS


def _valid_component(name: str) -> bool:
    if not name or name in (".", ".."):
        return False
    if "/" in name or "\0" in name:
        return False
    return all(ord(ch) >= 32 for ch in name)


class SafeDir:
    """A directory whose identity is pinned by an open, no-follow fd."""

    __slots__ = ("fd",)

    def __init__(self, fd: int):
        self.fd = fd

    def close(self) -> None:
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None

    def __enter__(self) -> "SafeDir":
        return self

    def __exit__(self, *_exc) -> None:
        self.close()

    @classmethod
    def open_root(cls) -> "SafeDir":
        return cls(os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW))

    def _check_owner_mode(self, st: os.stat_result, allowed_uids) -> None:
        if st.st_uid not in allowed_uids:
            raise Unsafe("unexpected owner")
        if st.st_mode & 0o022:
            raise Unsafe("group- or world-writable")

    def enter(self, name: str, *, create: bool = False, mode: int = 0o700,
              allowed_uids=None) -> "SafeDir":
        if allowed_uids is None:
            allowed_uids = _trusted_uids()
        if not _valid_component(name):
            raise Unsafe(f"unsafe path component: {name!r}")
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        try:
            fd = os.open(name, flags, dir_fd=self.fd)
        except FileNotFoundError:
            if not create:
                raise
            os.mkdir(name, mode, dir_fd=self.fd)
            fd = os.open(name, flags, dir_fd=self.fd)
        except NotADirectoryError as exc:
            raise Unsafe(f"{name} exists and is not a directory") from exc
        try:
            self._check_owner_mode(os.fstat(fd), allowed_uids)
        except Unsafe:
            os.close(fd)
            raise
        return SafeDir(fd)

    def walk(self, path: str, *, create: bool = False,
              allowed_uids=None) -> "SafeDir":
        if allowed_uids is None:
            allowed_uids = _trusted_uids()
        cur: SafeDir = self
        opened: list[SafeDir] = []
        try:
            for part in [p for p in path.strip("/").split("/") if p]:
                nxt = cur.enter(part, create=create, allowed_uids=allowed_uids)
                opened.append(nxt)
                cur = nxt
        except BaseException:
            for d in opened:
                d.close()
            raise
        for d in opened[:-1]:
            d.close()
        return opened[-1] if opened else SafeDir(os.dup(self.fd))

    def atomic_write(self, name: str, data: bytes, mode: int = 0o600) -> None:
        if not _valid_component(name):
            raise Unsafe(f"unsafe filename: {name!r}")
        tmp = ".ff-" + secrets.token_hex(10)
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                     mode, dir_fd=self.fd)
        try:
            with os.fdopen(fd, "wb") as fh:
                fh.write(data)
                fh.flush()
                os.fsync(fh.fileno())
            os.rename(tmp, name, src_dir_fd=self.fd, dst_dir_fd=self.fd)
        except BaseException:
            try:
                os.unlink(tmp, dir_fd=self.fd)
            except OSError:
                pass
            raise
        try:
            os.fsync(self.fd)
        except OSError:
            pass

    def read_bounded(self, name: str, max_bytes: int, *, missing_ok: bool = False,
                      allowed_uids=None) -> "bytes | None":
        if allowed_uids is None:
            allowed_uids = _trusted_uids()
        if not _valid_component(name):
            raise Unsafe(f"unsafe filename: {name!r}")
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=self.fd)
        except FileNotFoundError:
            if missing_ok:
                return None
            raise
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode):
                raise Unsafe(f"{name} is not a regular file")
            self._check_owner_mode(st, allowed_uids)
            if st.st_size > max_bytes:
                raise Unsafe(f"{name} is too large")
            data = bytearray()
            while True:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                data += chunk
                if len(data) > max_bytes:
                    raise Unsafe(f"{name} is too large")
            return bytes(data)
        finally:
            os.close(fd)

    def unlink(self, name: str) -> None:
        try:
            os.unlink(name, dir_fd=self.fd)
        except FileNotFoundError:
            pass

    def remove_tree(self, name: str, *, max_entries: int = 200_000, max_depth: int = 64) -> None:
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY, dir_fd=self.fd)
        except FileNotFoundError:
            return
        except NotADirectoryError:
            os.unlink(name, dir_fd=self.fd)
            return
        counter = [0]

        def wipe(dfd: int, depth: int) -> None:
            if depth > max_depth:
                raise Unsafe("tree too deep")
            with os.scandir(dfd) as it:
                entries = list(it)
            for entry in entries:
                counter[0] += 1
                if counter[0] > max_entries:
                    raise Unsafe("tree too large")
                if entry.is_dir(follow_symlinks=False):
                    child = os.open(entry.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY, dir_fd=dfd)
                    try:
                        wipe(child, depth + 1)
                    finally:
                        os.close(child)
                    os.rmdir(entry.name, dir_fd=dfd)
                else:
                    os.unlink(entry.name, dir_fd=dfd)

        try:
            wipe(fd, 0)
        finally:
            os.close(fd)
        os.rmdir(name, dir_fd=self.fd)

    def scandir_names(self):
        with os.scandir(self.fd) as it:
            yield from list(it)


def open_home() -> SafeDir:
    if not HOME.startswith("/"):
        raise Unsafe("unexpected home directory")
    root = SafeDir.open_root()
    try:
        return root.walk(HOME)
    finally:
        root.close()


def ensure_state_dir(rel_path: str) -> SafeDir:
    """Open (creating component-wise as needed) a directory under HOME."""
    with open_home() as home:
        return home.walk(rel_path, create=True)


def open_state_dir(rel_path: str) -> "SafeDir | None":
    try:
        with open_home() as home:
            return home.walk(rel_path)
    except (FileNotFoundError, Unsafe):
        return None


def rel_to_home(path: str) -> str:
    return os.path.relpath(path, HOME)


# =======================================================================
# Verified tool resolution — closed PATH, root-owned regular executables
# only, symlinks followed at most three hops and only within /usr.
# =======================================================================

_TRUSTED_BASES = ("/usr/bin/", "/usr/local/bin/")
_TRUSTED_LINK_TARGETS = ("/usr/bin/", "/usr/local/bin/", "/usr/lib/", "/usr/share/")


def _root_owned_ancestors(dirpath: str) -> bool:
    try:
        root = SafeDir.open_root()
    except OSError:
        return False
    try:
        root.walk(dirpath, allowed_uids=frozenset({0}) | _EXTRA_TRUSTED_UIDS).close()
        return True
    except (Unsafe, OSError):
        return False
    finally:
        root.close()


def _leaf_is_safe_exec(path: str) -> bool:
    try:
        st = os.lstat(path)
    except OSError:
        return False
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        return False
    if st.st_uid not in (frozenset({0}) | _EXTRA_TRUSTED_UIDS) or st.st_mode & 0o022 or not st.st_mode & 0o111:
        return False
    return True


def verified_exec(path: str) -> "str | None":
    hops = 0
    while True:
        if not path.startswith(_TRUSTED_BASES):
            return None
        try:
            st = os.lstat(path)
        except OSError:
            return None
        if stat.S_ISLNK(st.st_mode):
            hops += 1
            if hops > 3 or st.st_uid not in (frozenset({0}) | _EXTRA_TRUSTED_UIDS):
                return None
            if not _root_owned_ancestors(os.path.dirname(path)):
                return None
            try:
                target = os.readlink(path)
            except OSError:
                return None
            if not target or ".." in target.split("/"):
                return None
            if not target.startswith("/"):
                target = os.path.normpath(os.path.join(os.path.dirname(path), target))
            else:
                target = os.path.normpath(target)
            if not target.startswith(_TRUSTED_LINK_TARGETS):
                return None
            path = target
            continue
        if not _leaf_is_safe_exec(path):
            return None
        if not _root_owned_ancestors(os.path.dirname(path)):
            return None
        return path


def find_verified(name: str) -> "str | None":
    for base in ("/usr/bin", "/usr/local/bin"):
        resolved = verified_exec(f"{base}/{name}")
        if resolved:
            return resolved
    return None


class Tools:
    python3 = ""
    systemctl = ""
    gio = ""
    nautilus = ""
    omarchy = ""
    xdg_terminal = ""
    rclone = ""


def resolve_tools() -> None:
    Tools.python3 = find_verified("python3") or ""
    Tools.systemctl = find_verified("systemctl") or ""
    Tools.gio = find_verified("gio") or ""
    Tools.nautilus = find_verified("nautilus") or ""
    Tools.omarchy = find_verified("omarchy") or ""
    Tools.xdg_terminal = find_verified("xdg-terminal-exec") or ""
    Tools.rclone = find_verified("rclone") or ""


# =======================================================================
# Bounded process execution
#
# Every subprocess is spawned with an explicit allow-listed environment, in
# its own session (so it can be group-killed without touching our caller),
# and — for run_bounded callers — with raw stdout/stderr capped in bytes
# *before* any line parsing, plus a monotonic deadline. On timeout or
# overflow the whole process group is TERM'd, then KILL'd, and reaped.
# =======================================================================

_ENV_KEEP_EXACT = frozenset({
    "HOME", "USER", "LOGNAME", "LANG", "TZ",
    "XDG_RUNTIME_DIR", "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP",
    "DBUS_SESSION_BUS_ADDRESS", "WAYLAND_DISPLAY", "DISPLAY",
    "HYPRLAND_INSTANCE_SIGNATURE",
})


def sanitized_child_env(extra: "dict | None" = None) -> dict:
    env = {"PATH": "/usr/bin"}
    for key, value in os.environ.items():
        if key in _ENV_KEEP_EXACT or key.startswith("LC_"):
            env[key] = value
    if extra:
        env.update(extra)
    return env


class BoundedResult:
    def __init__(self, returncode: int, stdout: bytes, stderr: bytes, *,
                 timed_out: bool = False, overflowed: bool = False):
        self.returncode = returncode
        self.stdout = stdout
        self.stderr = stderr
        self.timed_out = timed_out
        self.overflowed = overflowed

    @property
    def ok(self) -> bool:
        return self.returncode == 0 and not self.timed_out and not self.overflowed


def _killpg(proc: subprocess.Popen, *, force: bool) -> None:
    try:
        pgid = os.getpgid(proc.pid)
    except (ProcessLookupError, OSError):
        return
    try:
        os.killpg(pgid, signal.SIGKILL if force else signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        pass


def run_bounded(argv, *, timeout: float, cap: int = OUTPUT_CAP,
                input_bytes: "bytes | None" = None, env: "dict | None" = None) -> BoundedResult:
    proc = subprocess.Popen(
        argv,
        stdin=subprocess.PIPE if input_bytes is not None else subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env if env is not None else sanitized_child_env(),
        start_new_session=True,
        close_fds=True,
    )
    out = bytearray()
    err = bytearray()
    overflowed = False
    timed_out = False
    pipes = {proc.stdout.fileno(): ("out", proc.stdout), proc.stderr.fileno(): ("err", proc.stderr)}
    for fh in (proc.stdout, proc.stderr):
        os.set_blocking(fh.fileno(), False)
    if input_bytes is not None:
        try:
            proc.stdin.write(input_bytes)
        except (BrokenPipeError, OSError):
            pass
        finally:
            try:
                proc.stdin.close()
            except OSError:
                pass

    deadline = time.monotonic() + timeout
    open_fds = set(pipes)
    try:
        while open_fds:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                break
            ready, _, _ = select.select(list(open_fds), [], [], min(remaining, 0.25))
            for fd in ready:
                which, _fh = pipes[fd]
                try:
                    chunk = os.read(fd, 65536)
                except OSError:
                    chunk = b""
                if not chunk:
                    open_fds.discard(fd)
                    continue
                target = out if which == "out" else err
                if len(target) < cap:
                    target.extend(chunk[: cap - len(target)])
                if len(target) >= cap:
                    overflowed = True
            if overflowed:
                break
        if timed_out or overflowed:
            _killpg(proc, force=False)
    finally:
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            _killpg(proc, force=True)
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                pass
        for fh in (proc.stdout, proc.stderr):
            try:
                fh.close()
            except OSError:
                pass
        if proc.stdin is not None:
            try:
                proc.stdin.close()
            except OSError:
                pass

    return BoundedResult(proc.returncode or 0, bytes(out), bytes(err),
                         timed_out=timed_out, overflowed=overflowed)


def spawn_detached(argv, env: "dict | None" = None) -> None:
    """Fire-and-forget a process (terminal, file manager) in its own
    session so it outlives and is never reaped or signalled by us."""
    subprocess.Popen(
        argv,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=env if env is not None else sanitized_child_env(),
        start_new_session=True,
        close_fds=True,
    )


# =======================================================================
# Config — cache size and cache max age only. Everything else is fixed.
# =======================================================================

def valid_cache_size(value: str) -> bool:
    return value in CACHE_SIZE_CHOICES


def valid_cache_age_hours(value: str) -> bool:
    if not re.fullmatch(r"[0-9]{1,4}", value):
        return False
    return MIN_CACHE_MAX_AGE_HOURS <= int(value) <= MAX_CACHE_MAX_AGE_HOURS


class Config:
    cache_max_size = DEFAULT_CACHE_MAX_SIZE
    cache_max_age_hours = DEFAULT_CACHE_MAX_AGE_HOURS

    @property
    def cache_max_age(self) -> str:
        return f"{self.cache_max_age_hours}h"


def load_config() -> Config:
    cfg = Config()
    cfg.cache_max_size = DEFAULT_CACHE_MAX_SIZE
    cfg.cache_max_age_hours = DEFAULT_CACHE_MAX_AGE_HOURS
    d = open_state_dir(rel_to_home(CONFIG_DIR))
    if d is None:
        return cfg
    try:
        try:
            data = d.read_bounded("config", 65536, missing_ok=True)
        except Unsafe as exc:
            print(f"{APP}: {exc}, using defaults", file=sys.stderr)
            return cfg
        if data is None:
            return cfg
        legacy_age = None
        for line in data.decode("utf-8", "replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.partition("=")
            key, value = key.strip(), value.strip()
            if key == "cache_max_size":
                if valid_cache_size(value):
                    cfg.cache_max_size = value
                else:
                    print(f"{APP}: invalid cache_max_size '{value}' in config, using default", file=sys.stderr)
            elif key == "cache_max_age_hours":
                if valid_cache_age_hours(value):
                    cfg.cache_max_age_hours = int(value)
                else:
                    print(f"{APP}: invalid cache_max_age_hours '{value}' in config, using default", file=sys.stderr)
            elif key == "cache_max_age":
                # Pre-0.2 configs stored a duration string; migrate hours only.
                m = re.fullmatch(r"([0-9]{1,4})h", value)
                if m and valid_cache_age_hours(m.group(1)):
                    legacy_age = int(m.group(1))
            # Any other legacy key (remote/bind/dav_host/display_name/
            # vfs_cache_mode/addr) is intentionally dropped: those are now
            # fixed constants, not configurable, and self-heal on next save.
        if legacy_age is not None and cfg.cache_max_age_hours == DEFAULT_CACHE_MAX_AGE_HOURS:
            cfg.cache_max_age_hours = legacy_age
        return cfg
    finally:
        d.close()


def save_config(cfg: Config) -> None:
    d = ensure_state_dir(rel_to_home(CONFIG_DIR))
    try:
        body = (
            f"cache_max_size={cfg.cache_max_size}\n"
            f"cache_max_age_hours={cfg.cache_max_age_hours}\n"
        )
        d.atomic_write("config", body.encode("ascii"), 0o600)
    finally:
        d.close()


# =======================================================================
# rclone remote / session checks
# =======================================================================

def remote_configured() -> bool:
    if not Tools.rclone:
        return False
    result = run_bounded([Tools.rclone, "listremotes"], timeout=5, env=sanitized_child_env())
    if not result.ok:
        return False
    names = {line.strip().rstrip(":") for line in result.stdout.decode("utf-8", "replace").splitlines()}
    return REMOTE_NAME in names


def session_present() -> bool:
    import configparser

    d = open_state_dir(rel_to_home(RCLONE_CONF_DIR))
    if d is None:
        return False
    try:
        try:
            data = d.read_bounded("rclone.conf", 1_048_576, missing_ok=True)
        except Unsafe:
            return False
        if data is None:
            return False
        parser = configparser.ConfigParser()
        try:
            parser.read_string(data.decode("utf-8", "replace"))
        except configparser.Error:
            return False
        if not parser.has_section(REMOTE_NAME):
            return False
        token = parser.get(REMOTE_NAME, "trust_token", fallback="").strip()
        cookies = parser.get(REMOTE_NAME, "cookies", fallback="").strip()
        return bool(token or cookies)
    finally:
        d.close()


# =======================================================================
# WebDAV authentication
#
# A random per-install credential lives in CONFIG_DIR, owner-only. rclone
# is handed only the htpasswd hash, via an inherited directory fd, never a
# path that could be swapped later. GVFS gets the plaintext through
# Gio.MountOperation, in memory: never the URI, argv, bookmark, or journal.
# Before the password is ever supplied to GVFS, the listener is proven to
# be owned by the current systemd MainPID running the verified rclone
# binary with authenticated arguments.
# =======================================================================

WEBDAV_PASSWORD_FILE = "webdav-password"
WEBDAV_HTPASSWD_FILE = "webdav.htpasswd"
MAX_SECRET = 256
PASSWORD_RE = re.compile(r"[A-Za-z0-9_-]{40,128}\Z")
IPV4_LOOPBACK_HEX = "0100007F"
IPV6_LOOPBACK_HEX = "00000000000000000000000001000000"


class AuthError(RuntimeError):
    pass


def _expected_htpasswd(password: str) -> bytes:
    digest = base64.b64encode(hashlib.sha1(password.encode()).digest()).decode()
    return f"{WEBDAV_USER}:{{SHA}}{digest}\n".encode()


def _password_from_dir(d: SafeDir, *, create: bool) -> str:
    raw = d.read_bounded(WEBDAV_PASSWORD_FILE, MAX_SECRET, missing_ok=create,
                          allowed_uids=frozenset({os.getuid()}))
    if raw is None:
        password = secrets.token_urlsafe(32)
        d.atomic_write(WEBDAV_PASSWORD_FILE, (password + "\n").encode(), 0o600)
        return password
    try:
        password = raw.decode("ascii").strip()
    except UnicodeDecodeError as exc:
        raise AuthError("invalid local WebDAV password") from exc
    if not PASSWORD_RE.fullmatch(password):
        raise AuthError("invalid local WebDAV password")
    return password


def ensure_webdav_auth() -> None:
    d = ensure_state_dir(rel_to_home(CONFIG_DIR))
    try:
        password = _password_from_dir(d, create=True)
        d.atomic_write(WEBDAV_HTPASSWD_FILE, _expected_htpasswd(password), 0o600)
    finally:
        d.close()


def validate_webdav_auth(d: SafeDir) -> str:
    password = _password_from_dir(d, create=False)
    actual = d.read_bounded(WEBDAV_HTPASSWD_FILE, MAX_SECRET,
                             allowed_uids=frozenset({os.getuid()}))
    if actual != _expected_htpasswd(password):
        raise AuthError("local WebDAV credentials do not match")
    return password


def _socket_inodes(pid: int) -> set:
    result = set()
    try:
        with os.scandir(f"/proc/{pid}/fd") as it:
            for count, entry in enumerate(it):
                if count >= 8192:
                    raise AuthError("service has too many file descriptors")
                try:
                    target = os.readlink(entry.path)
                except OSError:
                    continue
                if target.startswith("socket:[") and target.endswith("]"):
                    result.add(target[8:-1])
    except OSError as exc:
        raise AuthError("cannot inspect service sockets") from exc
    return result


def _table_listener_inode(table: str, address: str, port: int) -> "str | None":
    expected = f"{address}:{port:04X}"
    try:
        with open(table, encoding="ascii") as fh:
            next(fh, None)
            for line in fh:
                fields = line.split()
                if len(fields) > 9 and fields[1].upper() == expected and fields[3] == "0A":
                    return fields[9]
    except OSError:
        return None
    return None


def listener_owned(pid: int, rclone_bin: str) -> None:
    if pid <= 1:
        raise AuthError("invalid service identity")
    try:
        exe = os.path.realpath(f"/proc/{pid}/exe")
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            cmdline = fh.read(8192).split(b"\0")
    except OSError as exc:
        raise AuthError("service process disappeared") from exc
    if exe != os.path.realpath(rclone_bin):
        raise AuthError("listener is not the expected rclone process")
    if b"serve" not in cmdline or b"webdav" not in cmdline or b"--htpasswd" not in cmdline:
        raise AuthError("rclone service is missing authenticated WebDAV arguments")
    index = cmdline.index(b"--htpasswd")
    if index + 1 >= len(cmdline):
        raise AuthError("rclone service has no htpasswd value")
    htpasswd_arg = cmdline[index + 1]
    if not htpasswd_arg.startswith(b"/proc/self/fd/") or not htpasswd_arg.endswith(b"/" + WEBDAV_HTPASSWD_FILE.encode()):
        raise AuthError("rclone service has an unexpected htpasswd source")
    expected = {
        _table_listener_inode("/proc/net/tcp", IPV4_LOOPBACK_HEX, PORT),
        _table_listener_inode("/proc/net/tcp6", IPV6_LOOPBACK_HEX, PORT),
    }
    if None in expected or not expected.issubset(_socket_inodes(pid)):
        raise AuthError("WebDAV listeners are not owned by the service MainPID")


def authenticated_options(password: str) -> bool:
    token = base64.b64encode(f"{WEBDAV_USER}:{password}".encode()).decode()
    conn = http.client.HTTPConnection(BIND_V4, PORT, timeout=0.4)
    try:
        conn.request("OPTIONS", "/", headers={"Authorization": f"Basic {token}"})
        response = conn.getresponse()
        response.read(1024)
        return response.status == 200
    except OSError:
        return False
    finally:
        conn.close()


def wait_webdav_ready(pid: int, rclone_bin: str) -> None:
    d = open_state_dir(rel_to_home(CONFIG_DIR))
    if d is None:
        fail("config directory missing")
    try:
        password = validate_webdav_auth(d)
    except AuthError as exc:
        fail(str(exc))
    finally:
        d.close()
    for _ in range(40):
        try:
            listener_owned(pid, rclone_bin)
        except AuthError:
            pass
        else:
            if authenticated_options(password):
                return
        time.sleep(0.15)
    fail("authenticated WebDAV service did not become ready")


def mount_dav(pid: int, rclone_bin: str) -> None:
    d = open_state_dir(rel_to_home(CONFIG_DIR))
    if d is None:
        fail("config directory missing")
    try:
        password = validate_webdav_auth(d)
    except AuthError as exc:
        fail(str(exc))
    finally:
        d.close()
    try:
        listener_owned(pid, rclone_bin)
    except AuthError as exc:
        fail(str(exc))
    if not authenticated_options(password):
        fail("authenticated WebDAV readiness check failed")

    from gi.repository import Gio, GLib  # noqa: E402  (import here: only mount needs GObject)

    loop = GLib.MainLoop()
    result = {"ok": False, "error": None}
    operation = Gio.MountOperation()
    cancellable = Gio.Cancellable()
    operation.set_username(WEBDAV_USER)
    operation.set_password(password)
    operation.set_password_save(Gio.PasswordSave.NEVER)

    def ask_password(op, *_a):
        op.set_username(WEBDAV_USER)
        op.set_password(password)
        op.set_password_save(Gio.PasswordSave.NEVER)
        op.reply(Gio.MountOperationResult.HANDLED)

    def done(source, async_result):
        try:
            source.mount_enclosing_volume_finish(async_result)
            result["ok"] = True
        except GLib.Error as exc:
            if exc.matches(Gio.io_error_quark(), Gio.IOErrorEnum.ALREADY_MOUNTED):
                result["ok"] = True
            else:
                result["error"] = str(exc)
        loop.quit()

    def timeout():
        cancellable.cancel()
        loop.quit()
        return False

    operation.connect("ask-password", ask_password)
    gfile = Gio.File.new_for_uri(DAV_URI)
    gfile.mount_enclosing_volume(Gio.MountMountFlags.NONE, operation, cancellable, done)
    GLib.timeout_add_seconds(10, timeout)
    loop.run()
    try:
        listener_owned(pid, rclone_bin)
    except AuthError as exc:
        fail(str(exc))
    if not result["ok"]:
        fail(result["error"] or "timed out mounting authenticated WebDAV")


