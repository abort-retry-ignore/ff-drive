#!/usr/bin/env bash
# Fast Fruit Drive — rclone iCloud WebDAV helper for the Omarchy widget.
set -euo pipefail

APP=fast-fruit-drive
UNIT=fast-fruit-drive.service
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PLUGIN_DIR=$(cd "$HERE/.." && pwd)
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$APP"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/$APP"
CONFIG_FILE="$CONFIG_DIR/config"
UNIT_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"
BOOKMARKS="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/bookmarks"
RCLONE_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/rclone/rclone.conf"

DEFAULT_REMOTE="icloud:"
DEFAULT_BIND="127.0.0.1:8080"
DEFAULT_DAV_HOST="iCloud.localhost"
DEFAULT_CACHE_MAX_SIZE="4G"
DEFAULT_CACHE_MAX_AGE="24h"
DEFAULT_DISPLAY_NAME="iCloud Drive"
DEFAULT_VFS_CACHE_MODE="full"

usage() {
  cat <<EOF
Usage: $APP <command> [args]

Commands:
  status                         JSON status for the bar widget
  start                          Start WebDAV, mount, bookmark as iCloud Drive
  stop                           Stop WebDAV and unmount
  restart                        Restart the user service
  toggle                         Start if stopped, stop if running
  open                           Start if needed and open in Nautilus
  login                          Open a terminal for iCloud sign-in / reconnect
  login-tui                      Interactive rclone reconnect (run inside a terminal)
  serve                          Exec rclone (systemd ExecStart)
  ensure                         Write unit, config, and Nautilus bookmark
  configure KEY=VAL [...]        Update config; add restart=1 to bounce rclone
  clear-cache                    Bounce rclone and wipe the local file cache
  uninstall                      Stop and delete unit, bookmark, emblems, config, cache
  help                           Show this help
EOF
}

fail() {
  echo "$APP: $*" >&2
  exit 1
}

bool() {
  case "${1,,}" in
    1|true|yes|on) echo true ;;
    0|false|no|off) echo false ;;
    *) echo "$1" ;;
  esac
}

ensure_dirs() {
  mkdir -p "$CONFIG_DIR" "$CACHE_DIR" "$(dirname "$UNIT_FILE")" "$(dirname "$BOOKMARKS")"
}

save_config() {
  ensure_dirs
  cat >"$CONFIG_FILE" <<EOF
remote=$remote
bind=$bind
dav_host=$dav_host
cache_max_size=$cache_max_size
cache_max_age=$cache_max_age
display_name=$display_name
vfs_cache_mode=$vfs_cache_mode
EOF
}

write_default_config() {
  ensure_dirs
  if [[ ! -f $CONFIG_FILE ]]; then
    remote=$DEFAULT_REMOTE
    bind=$DEFAULT_BIND
    dav_host=$DEFAULT_DAV_HOST
    cache_max_size=$DEFAULT_CACHE_MAX_SIZE
    cache_max_age=$DEFAULT_CACHE_MAX_AGE
    display_name=$DEFAULT_DISPLAY_NAME
    vfs_cache_mode=$DEFAULT_VFS_CACHE_MODE
    save_config
  fi
}

load_config() {
  write_default_config
  remote=$DEFAULT_REMOTE
  bind=$DEFAULT_BIND
  dav_host=$DEFAULT_DAV_HOST
  cache_max_size=$DEFAULT_CACHE_MAX_SIZE
  cache_max_age=$DEFAULT_CACHE_MAX_AGE
  display_name=$DEFAULT_DISPLAY_NAME
  vfs_cache_mode=$DEFAULT_VFS_CACHE_MODE
  local key value
  while IFS='=' read -r key value; do
    [[ -z ${key:-} || $key == \#* ]] && continue
    case $key in
      remote) remote=$value ;;
      bind) bind=$value ;;
      addr)
        # Migrate v0.1 bind-only configs.
        bind=$value
        dav_host=$DEFAULT_DAV_HOST
        ;;
      dav_host) dav_host=$value ;;
      cache_max_size) cache_max_size=$value ;;
      cache_max_age) cache_max_age=$value ;;
      display_name) display_name=$value ;;
      vfs_cache_mode) vfs_cache_mode=$value ;;
    esac
  done <"$CONFIG_FILE"
  [[ $remote == *: ]] || remote="${remote}:"
  port=${bind##*:}
  dav_uri="dav://${dav_host}:${port}/"
  old_uri="dav://127.0.0.1:${port}/"
}

find_rclone() {
  if [[ -x $HOME/.local/bin/rclone ]]; then
    echo "$HOME/.local/bin/rclone"
    return
  fi
  command -v rclone 2>/dev/null || true
}

remote_configured() {
  local rclone_bin=$1
  [[ -n $rclone_bin ]] || return 1
  "$rclone_bin" listremotes 2>/dev/null | grep -Fxq "$remote"
}

# True when rclone.conf has a session for the remote (trust_token or cookies).
# Does not print secrets.
session_present() {
  local name=${remote%:}
  python3 - "$RCLONE_CONF" "$name" <<'PY'
import configparser, sys
path, section = sys.argv[1], sys.argv[2]
c = configparser.ConfigParser()
try:
    c.read(path)
except Exception:
    sys.exit(1)
if not c.has_section(section):
    sys.exit(1)
token = c.get(section, "trust_token", fallback="").strip()
cookies = c.get(section, "cookies", fallback="").strip()
sys.exit(0 if token or cookies else 1)
PY
}

write_unit() {
  load_config
  cat >"$UNIT_FILE" <<EOF
[Unit]
Description=Fast Fruit Drive — rclone iCloud WebDAV for Nautilus
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=$HERE/$APP serve
Restart=on-failure
RestartSec=5s
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=$APP

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable "$UNIT" >/dev/null
}

ensure_bookmark() {
  load_config
  local tmp line
  mkdir -p "$(dirname "$BOOKMARKS")"
  touch "$BOOKMARKS"
  tmp=$(mktemp)
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == dav://* ]] && [[ $line == *"iCloud Drive" || $line == *"iCloud WebDAV" || $line == "$dav_uri"* || $line == "$old_uri"* ]]; then
      continue
    fi
    printf '%s\n' "$line"
  done <"$BOOKMARKS" >"$tmp"
  printf '%s %s\n' "$dav_uri" "$display_name" >>"$tmp"
  mv "$tmp" "$BOOKMARKS"
}

service_running() {
  systemctl --user is-active --quiet "$UNIT"
}

gio_mounted() {
  load_config
  gio mount -l 2>/dev/null | grep -Fq "$dav_uri"
}

label_mount() {
  load_config
  gio set -t string "$dav_uri" metadata::display-name "$display_name" >/dev/null 2>&1 || true
}

mount_dav() {
  load_config
  gio mount -u "$old_uri" >/dev/null 2>&1 || true
  gio mount "$dav_uri" >/dev/null 2>&1 || true
  label_mount
}

unmount_dav() {
  load_config
  gio mount -u "$dav_uri" >/dev/null 2>&1 || true
  gio mount -u "$old_uri" >/dev/null 2>&1 || true
}

cache_bytes() {
  if [[ -d $CACHE_DIR ]]; then
    du -sb "$CACHE_DIR" 2>/dev/null | awk '{print $1}'
  else
    echo 0
  fi
}

install_nautilus_extension() {
  local src dest dir
  src="$PLUGIN_DIR/nautilus/fast_fruit_drive_nautilus.py"
  dir="${XDG_DATA_HOME:-$HOME/.local/share}/nautilus-python/extensions"
  dest="$dir/fast_fruit_drive_nautilus.py"
  [[ -f $src ]] || return 0
  mkdir -p "$dir"
  if [[ ! -f $dest ]] || ! cmp -s "$src" "$dest"; then
    cp -f "$src" "$dest"
  fi
}

# Abort before writing anything unless every required package is present.
# The fix command leads the message so the widget's one-line error stays useful.
require_packages() {
  local need_rclone=false need_gvfs=false
  [[ -n $(find_rclone) ]] || need_rclone=true
  [[ -x /usr/lib/gvfsd-dav ]] || need_gvfs=true
  if [[ $need_rclone == false && $need_gvfs == false ]]; then
    return 0
  fi
  {
    echo "$APP: required packages missing. Run: omarchy pkg add gvfs-dnssd rclone"
    [[ $need_rclone == true ]] && echo "  - rclone — serves iCloud over WebDAV (or a binary from rclone.org)"
    [[ $need_gvfs == true ]] && echo "  - gvfs-dnssd — the Nautilus WebDAV backend"
    echo "Then toggle Fast Fruit Drive on again."
  } >&2
  exit 1
}

cmd_ensure() {
  require_packages
  load_config
  save_config
  write_unit
  ensure_bookmark
  install_nautilus_extension
}

cmd_serve() {
  load_config
  local rclone_bin
  rclone_bin=$(find_rclone)
  [[ -n $rclone_bin ]] || fail "rclone not found"
  remote_configured "$rclone_bin" || fail "rclone remote '$remote' is not configured"
  mkdir -p "$CACHE_DIR"
  local args=(
    serve webdav "$remote"
    --addr "$bind"
    --addr "[::1]:${port}"
    --vfs-cache-mode "$vfs_cache_mode"
    --vfs-cache-max-size "$cache_max_size"
    --vfs-cache-max-age "$cache_max_age"
    --vfs-read-ahead 0
    --poll-interval 0
    --dir-cache-time 30s
    --cache-dir "$CACHE_DIR"
  )
  exec "$rclone_bin" "${args[@]}"
}

wait_for_server() {
  load_config
  local i
  for i in $(seq 1 40); do
    if curl -sf --max-time 0.4 -o /dev/null -X OPTIONS "http://${bind}/" 2>/dev/null; then
      return 0
    fi
    sleep 0.15
  done
  return 1
}

cmd_start() {
  cmd_ensure
  local rclone_bin
  rclone_bin=$(find_rclone)
  remote_configured "$rclone_bin" || fail "rclone remote '$remote' is not configured — use Sign in on the widget"
  session_present || fail "iCloud session missing or expired — use Sign in on the widget"
  systemctl --user start "$UNIT"
  service_running || fail "service failed to start — see: journalctl --user -u $UNIT"
  wait_for_server || fail "WebDAV did not become ready on http://${bind}/"
  mount_dav
  ensure_bookmark
}

cmd_stop() {
  unmount_dav
  systemctl --user stop "$UNIT" 2>/dev/null || true
  remove_bookmark
}

cmd_restart() {
  cmd_ensure
  systemctl --user restart "$UNIT"
  wait_for_server || fail "WebDAV did not become ready on http://${bind}/"
  mount_dav
  ensure_bookmark
}

cmd_toggle() {
  if service_running; then
    cmd_stop
  else
    cmd_start
  fi
}

cmd_open() {
  load_config
  service_running || cmd_start
  mount_dav
  ensure_bookmark
  if command -v uwsm-app >/dev/null 2>&1; then
    uwsm-app -- nautilus "$dav_uri" >/dev/null 2>&1 &
  else
    nautilus "$dav_uri" >/dev/null 2>&1 &
  fi
}

cmd_login() {
  if command -v omarchy >/dev/null 2>&1; then
    omarchy launch tui --app-id=io.github.abort-retry-ignore.ff-drive-login "$HERE/$APP" login-tui
    return
  fi
  if command -v xdg-terminal-exec >/dev/null 2>&1; then
    xdg-terminal-exec -e "$HERE/$APP" login-tui
    return
  fi
  fail "open a terminal and run: $HERE/$APP login-tui"
}

cmd_login_tui() {
  load_config
  local rclone_bin
  rclone_bin=$(find_rclone)
  [[ -n $rclone_bin ]] || fail "rclone not found"
  echo
  echo "Fast Fruit Drive — iCloud sign-in"
  echo
  echo "rclone stores a trust token in ~/.config/rclone/rclone.conf (not in this plugin)."
  echo "The token lasts about 30 days. After that, run Sign in again."
  echo "Use your real Apple ID password + 2FA. App-specific passwords are rejected."
  echo
  if remote_configured "$rclone_bin"; then
    echo "Reconnecting existing remote: $remote"
    echo
    "$rclone_bin" config reconnect "$remote"
  else
    echo "No '$remote' remote yet. In the rclone wizard:"
    echo "  n) New remote"
    echo "  name> icloud"
    echo "  Storage> iclouddrive"
    echo
    "$rclone_bin" config
  fi
  echo
  echo "Done. You can close this terminal. Toggle Fast Fruit Drive on from the bar."
  echo
}

cmd_configure() {
  load_config
  local restart=false
  local key value changed=false
  for pair in "$@"; do
    key=${pair%%=*}
    value=${pair#*=}
    case $key in
      cache_max_size) [[ $value == "$cache_max_size" ]] || changed=true; cache_max_size=$value ;;
      cache_max_age) [[ $value == "$cache_max_age" ]] || changed=true; cache_max_age=$value ;;
      cache_max_age_hours)
        value="${value}h"
        [[ $value == "$cache_max_age" ]] || changed=true
        cache_max_age=$value
        ;;
      remote) [[ $value == "$remote" ]] || changed=true; remote=$value ;;
      bind) [[ $value == "$bind" ]] || changed=true; bind=$value ;;
      dav_host) [[ $value == "$dav_host" ]] || changed=true; dav_host=$value ;;
      display_name) [[ $value == "$display_name" ]] || changed=true; display_name=$value ;;
      vfs_cache_mode) [[ $value == "$vfs_cache_mode" ]] || changed=true; vfs_cache_mode=$value ;;
      restart) restart=$(bool "$value") ;;
      *) fail "unknown configure key: $key" ;;
    esac
  done
  save_config
  if [[ $restart == true && $changed == true ]] && service_running; then
    cmd_restart
  else
    ensure_bookmark
  fi
}

cmd_clear_cache() {
  # Safe, near-instant cache wipe: rclone only reconciles its in-memory VFS
  # index at startup, so the file cache cannot be purged while it runs. Stop
  # the unit, wipe, start, and skip the slow parts (gio mount, bookmark, unit
  # rewrite) — WebDAV is stateless, gio reconnects on its own.
  local was_running=false freed
  freed=$(cache_bytes)
  service_running && was_running=true
  if [[ $was_running == true ]]; then
    systemctl --user stop "$UNIT" || fail "could not stop $UNIT"
  fi
  rm -rf "$CACHE_DIR"
  mkdir -p "$CACHE_DIR"
  if [[ $was_running == true ]]; then
    systemctl --user start "$UNIT" || fail "could not start $UNIT"
    wait_for_server || fail "WebDAV did not come back — see: journalctl --user -u $UNIT"
  fi
  echo "Cache cleared: $(numfmt --to=iec "$freed") freed from $CACHE_DIR"
}

remove_bookmark() {
  local tmp line port
  [[ -f $BOOKMARKS ]] || return 0
  if [[ -f $CONFIG_FILE ]]; then
    load_config
  else
    port=${DEFAULT_BIND##*:}
    dav_uri="dav://${DEFAULT_DAV_HOST}:${port}/"
    old_uri="dav://127.0.0.1:${port}/"
  fi
  tmp=$(mktemp)
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == dav://* ]] && [[ $line == *"iCloud Drive" || $line == *"iCloud WebDAV" || $line == "$dav_uri"* || $line == "$old_uri"* ]]; then
      continue
    fi
    printf '%s\n' "$line"
  done <"$BOOKMARKS" >"$tmp"
  mv "$tmp" "$BOOKMARKS"
}

remove_nautilus_extension() {
  local dir="${XDG_DATA_HOME:-$HOME/.local/share}/nautilus-python/extensions"
  rm -f "$dir/fast_fruit_drive_nautilus.py"
  rm -f "$dir/__pycache__/fast_fruit_drive_nautilus"*.pyc
}

cmd_uninstall() {
  cmd_stop
  systemctl --user disable --now "$UNIT" >/dev/null 2>&1 || true
  rm -f "$UNIT_FILE"
  rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/default.target.wants/$UNIT"
  systemctl --user reset-failed "$UNIT" >/dev/null 2>&1 || true
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  remove_bookmark
  remove_nautilus_extension
  rm -rf "$CONFIG_DIR" "$CACHE_DIR"
  echo "$APP: removed unit, bookmark, emblems, $CONFIG_DIR, and $CACHE_DIR"
  echo "$APP: left ~/.config/rclone/rclone.conf untouched (Apple session is rclone's)"
}

cmd_status() {
  load_config
  local rclone_bin running mounted configured gvfs rclone_found cache_used has_session
  rclone_bin=$(find_rclone)
  rclone_found=false
  [[ -n $rclone_bin ]] && rclone_found=true
  configured=false
  if [[ $rclone_found == true ]] && remote_configured "$rclone_bin"; then
    configured=true
  fi
  has_session=false
  if [[ $configured == true ]] && session_present; then
    has_session=true
  fi
  running=false
  service_running && running=true
  mounted=false
  gio_mounted && mounted=true
  gvfs=false
  [[ -x /usr/lib/gvfsd-dav ]] && gvfs=true
  cache_used=$(cache_bytes)
  local ready=false
  [[ $rclone_found == true && $configured == true && $has_session == true && $gvfs == true ]] && ready=true
  local needs_login=false
  [[ $rclone_found == true && ( $configured != true || $has_session != true ) ]] && needs_login=true
  local status_text="Stopped"
  if [[ $rclone_found != true ]]; then
    status_text="rclone not found"
  elif [[ $needs_login == true ]]; then
    status_text="Sign in to iCloud"
  elif [[ $gvfs != true ]]; then
    status_text="install gvfs-dnssd"
  elif [[ $running == true ]]; then
    status_text="Connected"
    [[ $mounted == true ]] || status_text="Serving"
  fi
  jq -n \
    --argjson ok true \
    --argjson ready "$ready" \
    --argjson running "$running" \
    --argjson mounted "$mounted" \
    --argjson rcloneFound "$rclone_found" \
    --argjson remoteConfigured "$configured" \
    --argjson hasSession "$has_session" \
    --argjson needsLogin "$needs_login" \
    --argjson gvfsDav "$gvfs" \
    --argjson cacheUsedBytes "$cache_used" \
    --arg statusText "$status_text" \
    --arg remote "$remote" \
    --arg addr "$bind" \
    --arg uri "$dav_uri" \
    --arg displayName "$display_name" \
    --arg cacheMaxSize "$cache_max_size" \
    --arg cacheMaxAge "$cache_max_age" \
    --arg cachePath "$CACHE_DIR" \
    --arg lastError "" \
    '{
      ok: $ok,
      ready: $ready,
      running: $running,
      mounted: $mounted,
      rcloneFound: $rcloneFound,
      remoteConfigured: $remoteConfigured,
      hasSession: $hasSession,
      needsLogin: $needsLogin,
      gvfsDav: $gvfsDav,
      cacheUsedBytes: $cacheUsedBytes,
      statusText: $statusText,
      remote: $remote,
      addr: $addr,
      uri: $uri,
      displayName: $displayName,
      cacheMaxSize: $cacheMaxSize,
      cacheMaxAge: $cacheMaxAge,
      cachePath: $cachePath,
      lastError: $lastError
    }'
}

cmd=${1:-help}
shift || true
case $cmd in
  status) cmd_status ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  toggle) cmd_toggle ;;
  open) cmd_open ;;
  login) cmd_login ;;
  login-tui) cmd_login_tui ;;
  serve) cmd_serve ;;
  ensure) cmd_ensure ;;
  configure) cmd_configure "$@" ;;
  clear-cache) cmd_clear_cache ;;
  uninstall) cmd_uninstall ;;
  help|-h|--help) usage ;;
  *) fail "unknown command: $cmd" ;;
esac
