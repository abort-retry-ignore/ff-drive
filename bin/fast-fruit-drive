# First line of every systemd unit and of the Nautilus extension this plugin
# installs into a shared, user-wide directory. It names the plugin ID, so a
# file with the same name from anything else is recognisably not ours.
OWNER_MARKER = f"# Managed-By: {PLUGIN_ID}"
MANIFEST_CAP = 65_536

