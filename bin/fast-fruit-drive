#!/usr/bin/bash
# Fast Fruit Drive — rclone iCloud WebDAV helper for the Omarchy widget.
set -euo pipefail

# Closed environment: user-writable PATH entries are never consulted.
# Named tools are still resolved as verified absolute executables below.
PATH=/usr/bin
export PATH

# If the widget watchdog SIGTERMs us, take the whole process group
# (curl/gio children). Nautilus is spawned with setsid so it survives.
trap 'trap - TERM INT; kill -- -$$ 2>/dev/null || true' TERM INT

readonly USER_UID=$EUID
readonly STAT=/usr/bin/stat
readonly MKDIR=/usr/bin/mkdir
readonly REALPATH=/usr/bin/realpath
readonly CAT=/usr/bin/cat
readonly SLEEP=/usr/bin/sleep
readonly READLINK=/usr/bin/readlink
readonly GREP=/usr/bin/grep
readonly AWK=/usr/bin/awk
readonly DU=/usr/bin/du
readonly NUMFMT=/usr/bin/numfmt

APP=fast-fruit-drive
UNIT=fast-fruit-drive.service
_src=${BASH_SOURCE[0]}
_dir=${_src%/*}
[[ $_dir == "$_src" ]] && _dir=.
HERE=$(cd "$_dir" && pwd)
PLUGIN_DIR=$(cd "$HERE/.." && pwd)
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$APP"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/$APP"
CONFIG_FILE="$CONFIG_DIR/config"
UNIT_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"
BOOKMARKS="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/bookmarks"
RCLONE_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/rclone/rclone.conf"

DEFAULT_REMOTE="icloud:"
DEFAULT_BIND="127.0.0.1:8080"
DEFAULT_DAV_HOST="iCloud.localhost"
DEFAULT_CACHE_MAX_SIZE="4G"
DEFAULT_CACHE_MAX_AGE="24h"
DEFAULT_DISPLAY_NAME="iCloud Drive"
DEFAULT_VFS_CACHE_MODE="full"

BIN_PYTHON3=
BIN_SYSTEMCTL=
BIN_GIO=
BIN_CURL=
BIN_JQ=
BIN_NAUTILUS=
BIN_SETSID=
BIN_OMARCHY=
BIN_XDG_TERMINAL=

usage() {
  $CAT <<EOF
Usage: $APP <command> [args]

Commands:
  status                         JSON status for the bar widget
  start                          Start WebDAV, mount, bookmark as iCloud Drive
  stop                           Stop WebDAV and unmount
  restart                        Restart the user service
  toggle                         Start if stopped, stop if running
  open                           Start if needed and open in Nautilus
  login                          Open a terminal for iCloud sign-in / reconnect
  login-tui                      Interactive rclone reconnect (run inside a terminal)
  serve                          Exec rclone (systemd ExecStart)
  ensure                         Write unit, config, and Nautilus bookmark
  configure KEY=VAL [...]        Update config; add restart=1 to bounce rclone
  clear-cache                    Bounce rclone and wipe the local file cache
  uninstall                      Stop and delete unit, bookmark, emblems, config, cache
  help                           Show this help
EOF
}

fail() {
  echo "$APP: $*" >&2
  exit 1
}

bool() {
  case "${1,,}" in
    1|true|yes|on) echo true ;;
    0|false|no|off) echo false ;;
    *) echo "$1" ;;
  esac
}

# ---- Safety primitives -------------------------------------------------

# Every component of path (checked no-follow: symlinks rejected) must be a
# real directory owned by this user or root and not group/world-writable.
safe_dir() {
  local path="$1" cur="" part owner mode
  [[ $path == /* ]] || return 1
  [[ $path == "/" ]] && return 0
  IFS='/' read -r -a parts <<< "${path#/}"
  for part in "${parts[@]}"; do
    [[ -n $part ]] || continue
    cur="$cur/$part"
    [[ ! -L $cur && -d $cur ]] || return 1
    owner=$($STAT -c '%u' "$cur")
    mode=$($STAT -c '%a' "$cur")
    [[ $owner == "$USER_UID" || $owner == 0 ]] || return 1
    [[ $((8#$mode & 0022)) -eq 0 ]] || return 1
  done
  return 0
}

# Same walk, but every ancestor must be root-owned (executable identity).
safe_dir_root() {
  local path="$1" cur="" part owner mode
  [[ $path == /* ]] || return 1
  [[ $path == "/" ]] && return 0
  IFS='/' read -r -a parts <<< "${path#/}"
  for part in "${parts[@]}"; do
    [[ -n $part ]] || continue
    cur="$cur/$part"
    [[ ! -L $cur && -d $cur ]] || return 1
    owner=$($STAT -c '%u' "$cur")
    mode=$($STAT -c '%a' "$cur")
    [[ $owner == 0 ]] || return 1
    [[ $((8#$mode & 0022)) -eq 0 ]] || return 1
  done
  return 0
}

# Leaf file: regular file, not a symlink, owned by this user or root.
safe_file() {
  local path="$1" owner
  [[ -f $path && ! -L $path ]] || return 1
  owner=$($STAT -c '%u' "$path")
  [[ $owner == "$USER_UID" || $owner == 0 ]]
}

# Executable accepted only at a root-owned, symlink-free location whose
# ancestors are all root-owned and not group/world-writable, so nothing in
# user-writable space can shadow what the long-lived service runs.
safe_exec() {
  local path="$1" dir owner mode
  [[ $path == /* ]] || return 1
  [[ -f $path && ! -L $path && -x $path ]] || return 1
  owner=$($STAT -c '%u' "$path")
  mode=$($STAT -c '%a' "$path")
  [[ $owner == 0 ]] || return 1
  [[ $((8#$mode & 0022)) -eq 0 ]] || return 1
  dir=${path%/*}
  safe_dir_root "$dir" || return 1
  return 0
}

# Resolve a /usr/bin or /usr/local/bin path to a verified regular executable.
# Root-owned symlinks are followed at most three hops, never through `..`,
# and only into /usr/{bin,local/bin,lib,share}.
verified_exec() {
  local path="$1" target owner hops=0
  [[ $path == /usr/bin/* || $path == /usr/local/bin/* ]] || return 1
  while [[ -L $path ]]; do
    hops=$((hops + 1))
    [[ $hops -le 3 ]] || return 1
    owner=$($STAT -c '%u' "$path")
    [[ $owner == 0 ]] || return 1
    safe_dir_root "${path%/*}" || return 1
    target=$($READLINK -n "$path") || return 1
    [[ -n $target && $target != *..* ]] || return 1
    [[ $target == /* ]] || target="${path%/*}/$target"
    [[ $target == /usr/bin/* || $target == /usr/local/bin/* || $target == /usr/lib/* || $target == /usr/share/* ]] || return 1
    path=$target
  done
  safe_exec "$path" || return 1
  printf '%s\n' "$path"
}

find_verified() {
  local name="$1" candidate resolved
  for candidate in "/usr/bin/$name" "/usr/local/bin/$name"; do
    resolved=$(verified_exec "$candidate") || continue
    printf '%s\n' "$resolved"
    return 0
  done
  return 1
}

# Create $1 component-wise. Never follows a symlink; existing components
# must pass safe_dir; missing components are mkdir'd and re-checked.
ensure_dir() {
  local path="$1" cur="" part owner mode
  [[ $path == /* ]] || return 1
  IFS='/' read -r -a parts <<< "${path#/}"
  for part in "${parts[@]}"; do
    [[ -n $part ]] || continue
    cur="$cur/$part"
    if [[ -L $cur || -e $cur ]]; then
      [[ ! -L $cur && -d $cur ]] || return 1
      owner=$($STAT -c '%u' "$cur")
      mode=$($STAT -c '%a' "$cur")
      [[ $owner == "$USER_UID" || $owner == 0 ]] || return 1
      [[ $((8#$mode & 0022)) -eq 0 ]] || return 1
    else
      $MKDIR -m 700 "$cur" || return 1
      [[ ! -L $cur && -d $cur ]] || return 1
      owner=$($STAT -c '%u' "$cur")
      [[ $owner == "$USER_UID" || $owner == 0 ]] || return 1
    fi
  done
  return 0
}

# Recursive delete, descriptor-relative. The chain is validated first
# (no symlinks, under the resolved home), then the PARENT directory is
# pinned and the tree is wiped through inherited dir FDs: os.open with
# O_NOFOLLOW|O_DIRECTORY at every level, os.unlink/os.rmdir with dir_fd —
# no pathname is re-resolved, and a swap between validation and deletion
# cannot redirect the delete.
safe_rm_rf() {
  local path="$1" real_home real_path parent rc=0
  [[ -L $path ]] && return 1
  [[ -e $path ]] || return 0
  real_home=$($REALPATH "$HOME")
  real_path=$($REALPATH "$path") || return 1
  [[ $real_path == "$real_home" || $real_path == "$real_home"/* ]] || return 1
  [[ $real_path == "$path" ]] || return 1
  safe_dir "$path" || return 1
  parent=${path%/*}
  exec {rmfd}<"$parent" || return 1
  "$BIN_PYTHON3" - "${path##*/}" "$rmfd" <<'PY' || rc=$?
import os, sys
name, parentfd = sys.argv[1], int(sys.argv[2])
try:
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY, dir_fd=parentfd)
except NotADirectoryError:
    os.unlink(name, dir_fd=parentfd)
    sys.exit(0)
except FileNotFoundError:
    sys.exit(0)
def wipe(fd):
    for entry in os.scandir(fd):
        if entry.is_dir(follow_symlinks=False):
            child = os.open(entry.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY, dir_fd=fd)
            wipe(child)
            os.close(child)
            os.rmdir(entry.name, dir_fd=fd)
        else:
            os.unlink(entry.name, dir_fd=fd)
wipe(fd)
os.close(fd)
os.rmdir(name, dir_fd=parentfd)
PY
  exec {rmfd}<&-
  return $rc
}

assert_coreutils() {
  local p
  # stat/readlink are the bootstrap for verified_exec itself.
  safe_exec "$STAT" || fail "refusing unverified tool: $STAT"
  safe_exec "$READLINK" || fail "refusing unverified tool: $READLINK"
  for p in "$MKDIR" "$REALPATH" "$CAT" "$SLEEP" "$GREP" "$AWK" "$DU" "$NUMFMT"; do
    verified_exec "$p" >/dev/null || fail "refusing unverified tool: $p"
  done
}

resolve_tools() {
  assert_coreutils
  BIN_PYTHON3=$(find_verified python3 || true)
  BIN_SYSTEMCTL=$(find_verified systemctl || true)
  BIN_GIO=$(find_verified gio || true)
  BIN_CURL=$(find_verified curl || true)
  BIN_JQ=$(find_verified jq || true)
  BIN_NAUTILUS=$(find_verified nautilus || true)
  BIN_SETSID=$(find_verified setsid || true)
  BIN_OMARCHY=$(find_verified omarchy || true)
  BIN_XDG_TERMINAL=$(find_verified xdg-terminal-exec || true)
}

# ---- Config value schemas ----------------------------------------------

valid_bind() {
  local value="$1" host port
  [[ $value == *:* ]] || return 1
  port=${value##*:}
  host=${value%:$port}
  [[ $port =~ ^[0-9]{1,5}$ ]] || return 1
  [[ 10#$port -ge 1 && 10#$port -le 65535 ]] || return 1
  [[ $host == "127.0.0.1" || $host == "[::1]" ]]
}

valid_remote_name() {
  [[ $1 =~ ^[a-zA-Z0-9_-]{1,64}$ && $1 != -* ]]
}

valid_size() {
  [[ $1 =~ ^[0-9]{1,7}[KMGT]?$ ]]
}

valid_age() {
  [[ $1 =~ ^[0-9]{1,7}(s|m|h|d|w)$ ]]
}

valid_host() {
  [[ $1 =~ ^[a-zA-Z0-9.-]{1,63}$ ]]
}

valid_display_name() {
  [[ $1 =~ ^[[:print:]]{1,64}$ ]]
}

valid_vfs_mode() {
  case $1 in
    off|minimal|writes|full) return 0 ;;
    *) return 1 ;;
  esac
}

ensure_dirs() {
  local d
  for d in "$CONFIG_DIR" "$CACHE_DIR" "${UNIT_FILE%/*}" "${BOOKMARKS%/*}"; do
    ensure_dir "$d" || fail "refusing to use unsafe directory: $d"
  done
}

# ---- Descriptor-relative state handling --------------------------------
# Every write, read, and delete below resolves against a directory FD that
# is pinned immediately after validation. The pinned descriptor retains the
# validated directory's identity, so a pathname swap after validation
# cannot redirect plugin state: nothing re-resolves a path. Leaf entries
# are opened with O_NOFOLLOW and destinations are replaced atomically
# (O_EXCL temp + rename), so a swapped symlink is refused or superseded
# rather than followed. The pinned FDs are inherited by the python children
# that perform the descriptor-relative work.

# fd_write NAME DIRFD MODE — stdin becomes pinned-dir/NAME, atomically.
# The script travels via -c so stdin carries the content being written.
fd_write() {
  local name="$1" dirfd="$2" mode="$3"
  "$BIN_PYTHON3" -c '
import os, sys
name, dirfd, mode = sys.argv[1], int(sys.argv[2]), int(sys.argv[3], 8)
data = sys.stdin.buffer.read(1048577)
if len(data) > 1048576:
    sys.exit(2)
tmp = ".ff-" + os.urandom(10).hex()
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode, dir_fd=dirfd)
with os.fdopen(fd, "wb") as fh:
    fh.write(data)
os.rename(tmp, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)
' "$name" "$dirfd" "$mode"
}

# fd_unlink DIRFD NAME... — remove leaf entries inside the pinned directory
# (unlinkat never follows symlinks; missing entries are ignored).
fd_unlink() {
  local dirfd="$1"
  shift
  "$BIN_PYTHON3" - "$dirfd" "$@" <<'PY'
import os, sys
dirfd = int(sys.argv[1])
for name in sys.argv[2:]:
    try:
        os.unlink(name, dir_fd=dirfd)
    except OSError:
        pass
PY
}

save_config() {
  ensure_dirs
  exec {cfgfd}<"$CONFIG_DIR" || fail "cannot pin config directory"
  fd_write "config" "$cfgfd" 600 <<EOF
remote=$remote
bind=$bind
dav_host=$dav_host
cache_max_size=$cache_max_size
cache_max_age=$cache_max_age
display_name=$display_name
vfs_cache_mode=$vfs_cache_mode
EOF
  exec {cfgfd}<&-
}

write_default_config() {
  ensure_dirs
  if [[ ! -f $CONFIG_FILE ]]; then
    remote=$DEFAULT_REMOTE
    bind=$DEFAULT_BIND
    dav_host=$DEFAULT_DAV_HOST
    cache_max_size=$DEFAULT_CACHE_MAX_SIZE
    cache_max_age=$DEFAULT_CACHE_MAX_AGE
    display_name=$DEFAULT_DISPLAY_NAME
    vfs_cache_mode=$DEFAULT_VFS_CACHE_MODE
    save_config
  fi
}

load_config() {
  write_default_config
  remote=$DEFAULT_REMOTE
  bind=$DEFAULT_BIND
  dav_host=$DEFAULT_DAV_HOST
  cache_max_size=$DEFAULT_CACHE_MAX_SIZE
  cache_max_age=$DEFAULT_CACHE_MAX_AGE
  display_name=$DEFAULT_DISPLAY_NAME
  vfs_cache_mode=$DEFAULT_VFS_CACHE_MODE
  local key value cfg_size remote_name
  cfg_size=$($STAT -c '%s' "$CONFIG_FILE" 2>/dev/null || echo 65537)
  if [[ 10#$cfg_size -le 65536 ]]; then
    while IFS='=' read -r key value; do
      [[ -z ${key:-} || $key == \#* ]] && continue
      case $key in
        remote) remote=$value ;;
        bind) bind=$value ;;
        addr)
          # Migrate v0.1 bind-only configs.
          bind=$value
          dav_host=$DEFAULT_DAV_HOST
          ;;
        dav_host) dav_host=$value ;;
        cache_max_size) cache_max_size=$value ;;
        cache_max_age) cache_max_age=$value ;;
        display_name) display_name=$value ;;
        vfs_cache_mode) vfs_cache_mode=$value ;;
      esac
    done <"$CONFIG_FILE"
  else
    echo "$APP: config is oversized, using defaults" >&2
  fi
  # Strict schemas: anything invalid falls back to the documented default.
  remote_name=${remote%:}
  if ! valid_remote_name "$remote_name"; then
    echo "$APP: invalid remote '$remote' in config, using default" >&2
    remote_name=${DEFAULT_REMOTE%:}
  fi
  remote="${remote_name}:"
  if ! valid_bind "$bind"; then
    echo "$APP: invalid bind '$bind' in config, using default" >&2
    bind=$DEFAULT_BIND
  fi
  if ! valid_size "$cache_max_size"; then
    echo "$APP: invalid cache_max_size '$cache_max_size' in config, using default" >&2
    cache_max_size=$DEFAULT_CACHE_MAX_SIZE
  fi
  if ! valid_age "$cache_max_age"; then
    echo "$APP: invalid cache_max_age '$cache_max_age' in config, using default" >&2
    cache_max_age=$DEFAULT_CACHE_MAX_AGE
  fi
  if ! valid_host "$dav_host"; then
    echo "$APP: invalid dav_host '$dav_host' in config, using default" >&2
    dav_host=$DEFAULT_DAV_HOST
  fi
  if ! valid_display_name "$display_name"; then
    echo "$APP: invalid display_name in config, using default" >&2
    display_name=$DEFAULT_DISPLAY_NAME
  fi
  if ! valid_vfs_mode "$vfs_cache_mode"; then
    echo "$APP: invalid vfs_cache_mode '$vfs_cache_mode' in config, using default" >&2
    vfs_cache_mode=$DEFAULT_VFS_CACHE_MODE
  fi
  port=${bind##*:}
  dav_uri="dav://${dav_host}:${port}/"
  old_uri="dav://127.0.0.1:${port}/"
}

find_rclone() {
  find_verified rclone || true
}

remote_configured() {
  local rclone_bin=$1
  [[ -n $rclone_bin ]] || return 1
  "$rclone_bin" listremotes 2>/dev/null | $GREP -Fxq "$remote"
}

# True when rclone.conf has a session for the remote (trust_token or cookies).
# Does not print secrets. File contents are passed on stdin, never by path.
session_present() {
  local name=${remote%:} sz
  [[ -n $BIN_PYTHON3 ]] || return 1
  [[ -f $RCLONE_CONF && ! -L $RCLONE_CONF ]] || return 1
  sz=$($STAT -c '%s' "$RCLONE_CONF" 2>/dev/null || echo 1048577)
  [[ 10#$sz -le 1048576 ]] || return 1
  "$BIN_PYTHON3" -c '
import configparser, sys
section = sys.argv[1]
blob = sys.stdin.read(1048577)
if len(blob) > 1048576:
    sys.exit(1)
c = configparser.ConfigParser()
try:
    c.read_string(blob)
except Exception:
    sys.exit(1)
if not c.has_section(section):
    sys.exit(1)
token = c.get(section, "trust_token", fallback="").strip()
cookies = c.get(section, "cookies", fallback="").strip()
sys.exit(0 if token or cookies else 1)
' "$name" < "$RCLONE_CONF"
}

write_unit() {
  load_config
  ensure_dir "${UNIT_FILE%/*}" || fail "refusing to use unsafe unit directory"
  exec {unitfd}<"${UNIT_FILE%/*}" || fail "cannot pin unit directory"
  fd_write "$UNIT" "$unitfd" 644 <<EOF
[Unit]
Description=Fast Fruit Drive — rclone iCloud WebDAV for Nautilus
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=$HERE/$APP serve
Restart=on-failure
RestartSec=5s
Environment=PATH=/usr/bin
NoNewPrivileges=yes
UMask=0077
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=$APP

[Install]
WantedBy=default.target
EOF
  exec {unitfd}<&-
  [[ -n $BIN_SYSTEMCTL ]] || fail "systemctl not found"
  "$BIN_SYSTEMCTL" --user daemon-reload
  "$BIN_SYSTEMCTL" --user enable "$UNIT" >/dev/null
}

# Atomic bookmark rewrite, entirely descriptor-relative against the
# pinned gtk-3.0 directory: existing lines are read with O_NOFOLLOW
# (capped at 1 MiB, owner-checked), our dav entries are filtered out, $1 is
# appended if non-empty, and the result replaces the file atomically.
rewrite_bookmarks() {
  local append="${1:-}" dir rc=0
  dir=${BOOKMARKS%/*}
  ensure_dir "$dir" || fail "refusing to touch unsafe bookmarks directory: $dir"
  exec {bmfd}<"$dir" || fail "cannot pin bookmarks directory"
  "$BIN_PYTHON3" - "$bmfd" "$dav_uri" "$old_uri" "$append" <<'PY' || rc=$?
import os, stat, sys
dirfd, dav_uri, old_uri, append = int(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
existing = b""
fd = None
try:
    fd = os.open("bookmarks", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dirfd)
except FileNotFoundError:
    fd = None
except OSError:
    sys.exit(2)
if fd is not None:
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid not in (os.getuid(), 0) or st.st_size > 1048576:
            sys.exit(2)
        while True:
            chunk = os.read(fd, 65536)
            if not chunk or len(existing) > 1048576:
                break
            existing += chunk
        if len(existing) > 1048576:
            sys.exit(2)
    finally:
        os.close(fd)
lines = existing.decode("utf-8", "replace").splitlines()
keep = [
    l for l in lines
    if not (l.startswith("dav://") and (
        "iCloud Drive" in l or "iCloud WebDAV" in l
        or l.startswith(dav_uri) or l.startswith(old_uri)))
]
if append:
    keep.append(append)
data = ("\n".join(keep) + "\n").encode("utf-8", "replace") if keep else b""
tmp = ".ff-" + os.urandom(10).hex()
wfd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dirfd)
with os.fdopen(wfd, "wb") as fh:
    fh.write(data)
os.rename(tmp, "bookmarks", src_dir_fd=dirfd, dst_dir_fd=dirfd)
PY
  exec {bmfd}<&-
  [[ $rc -eq 0 ]] || fail "cannot rewrite bookmarks safely"
}

ensure_bookmark() {
  load_config
  rewrite_bookmarks "$dav_uri $display_name"
}

service_running() {
  [[ -n $BIN_SYSTEMCTL ]] || return 1
  "$BIN_SYSTEMCTL" --user is-active --quiet "$UNIT"
}

gio_mounted() {
  load_config
  [[ -n $BIN_GIO ]] || return 1
  "$BIN_GIO" mount -l 2>/dev/null | $GREP -Fq "$dav_uri"
}

label_mount() {
  load_config
  [[ -n $BIN_GIO ]] || return 0
  "$BIN_GIO" set -t string "$dav_uri" metadata::display-name "$display_name" >/dev/null 2>&1 || true
}

mount_dav() {
  load_config
  [[ -n $BIN_GIO ]] || return 0
  "$BIN_GIO" mount -u "$old_uri" >/dev/null 2>&1 || true
  "$BIN_GIO" mount "$dav_uri" >/dev/null 2>&1 || true
  label_mount
}

unmount_dav() {
  load_config
  [[ -n $BIN_GIO ]] || return 0
  "$BIN_GIO" mount -u "$dav_uri" >/dev/null 2>&1 || true
  "$BIN_GIO" mount -u "$old_uri" >/dev/null 2>&1 || true
}

cache_bytes() {
  if [[ -d $CACHE_DIR ]]; then
    $DU -sb "$CACHE_DIR" 2>/dev/null | $AWK '{print $1}'
  else
    echo 0
  fi
}

install_nautilus_extension() {
  local src dir rc=0
  src="$PLUGIN_DIR/nautilus/fast_fruit_drive_nautilus.py"
  dir="${XDG_DATA_HOME:-$HOME/.local/share}/nautilus-python/extensions"
  [[ -f $src ]] || return 0
  ensure_dir "$dir" || fail "refusing to touch unsafe extension directory: $dir"
  exec {extfd}<"$dir" || fail "cannot pin extension directory"
  "$BIN_PYTHON3" - "$src" "$extfd" <<'PY' || rc=$?
import os, stat, sys
src, dirfd = sys.argv[1], int(sys.argv[2])
sfd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW)
try:
    st = os.fstat(sfd)
    if not stat.S_ISREG(st.st_mode) or st.st_size > 2097152:
        sys.exit(2)
    data = b""
    while True:
        chunk = os.read(sfd, 65536)
        if not chunk or len(data) > 2097152:
            break
        data += chunk
finally:
    os.close(sfd)
if len(data) > 2097152:
    sys.exit(2)
existing = None
try:
    efd = os.open("fast_fruit_drive_nautilus.py", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dirfd)
except FileNotFoundError:
    efd = None
except OSError:
    sys.exit(2)
if efd is not None:
    try:
        st = os.fstat(efd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid not in (os.getuid(), 0) or st.st_size > 2097152:
            sys.exit(2)
        existing = b""
        while True:
            chunk = os.read(efd, 65536)
            if not chunk or len(existing) > 2097152:
                break
            existing += chunk
    finally:
        os.close(efd)
if existing == data:
    sys.exit(0)
tmp = ".ff-" + os.urandom(10).hex()
wfd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=dirfd)
with os.fdopen(wfd, "wb") as fh:
    fh.write(data)
os.rename(tmp, "fast_fruit_drive_nautilus.py", src_dir_fd=dirfd, dst_dir_fd=dirfd)
PY
  exec {extfd}<&-
  [[ $rc -eq 0 ]] || fail "cannot install Nautilus extension safely"
}

# Abort before writing anything unless every required package is present.
# The fix command leads the message so the widget's one-line error stays useful.
require_packages() {
  local need_rclone=false need_gvfs=false
  [[ -n $(find_rclone) ]] || need_rclone=true
  [[ -x /usr/lib/gvfsd-dav ]] || need_gvfs=true
  if [[ $need_rclone == false && $need_gvfs == false ]]; then
    return 0
  fi
  {
    echo "$APP: required packages missing. Run: omarchy pkg add gvfs-dnssd rclone"
    [[ $need_rclone == true ]] && echo "  - rclone — serves iCloud over WebDAV"
    [[ $need_gvfs == true ]] && echo "  - gvfs-dnssd — the Nautilus WebDAV backend"
    echo "Then toggle Fast Fruit Drive on again."
  } >&2
  exit 1
}

cmd_ensure() {
  require_packages
  load_config
  save_config
  write_unit
  ensure_bookmark
  install_nautilus_extension
}

cmd_serve() {
  load_config
  local rclone_bin
  rclone_bin=$(find_rclone)
  [[ -n $rclone_bin ]] || fail "rclone not found"
  remote_configured "$rclone_bin" || fail "rclone remote '$remote' is not configured"
  ensure_dir "$CACHE_DIR" || fail "refusing to use unsafe cache directory: $CACHE_DIR"
  local args=(
    serve webdav "$remote"
    --addr "$bind"
    --addr "[::1]:${port}"
    --vfs-cache-mode "$vfs_cache_mode"
    --vfs-cache-max-size "$cache_max_size"
    --vfs-cache-max-age "$cache_max_age"
    --vfs-read-ahead 0
    --poll-interval 0
    --dir-cache-time 30s
    --cache-dir "$CACHE_DIR"
  )
  exec "$rclone_bin" "${args[@]}"
}

wait_for_server() {
  load_config
  local i
  [[ -n $BIN_CURL ]] || fail "curl not found"
  for i in {1..40}; do
    if "$BIN_CURL" -sf --max-time 0.4 -o /dev/null -X OPTIONS "http://${bind}/" 2>/dev/null; then
      return 0
    fi
    $SLEEP 0.15
  done
  return 1
}

cmd_start() {
  cmd_ensure
  local rclone_bin
  rclone_bin=$(find_rclone)
  remote_configured "$rclone_bin" || fail "rclone remote '$remote' is not configured — use Sign in on the widget"
  session_present || fail "iCloud session missing or expired — use Sign in on the widget"
  [[ -n $BIN_SYSTEMCTL ]] || fail "systemctl not found"
  "$BIN_SYSTEMCTL" --user start "$UNIT"
  service_running || fail "service failed to start — see: journalctl --user -u $UNIT"
  wait_for_server || fail "WebDAV did not become ready on http://${bind}/"
  mount_dav
  ensure_bookmark
}

cmd_stop() {
  unmount_dav
  [[ -n $BIN_SYSTEMCTL ]] || return 0
  "$BIN_SYSTEMCTL" --user stop "$UNIT" 2>/dev/null || true
  remove_bookmark
}

cmd_restart() {
  cmd_ensure
  [[ -n $BIN_SYSTEMCTL ]] || fail "systemctl not found"
  "$BIN_SYSTEMCTL" --user restart "$UNIT"
  wait_for_server || fail "WebDAV did not become ready on http://${bind}/"
  mount_dav
  ensure_bookmark
}

cmd_toggle() {
  if service_running; then
    cmd_stop
  else
    cmd_start
  fi
}

cmd_open() {
  load_config
  # Same path as Super-Shift-F: `omarchy launch nautilus` →
  # `setsid uwsm-app -- nautilus --new-window`. Do not pass the DAV URI —
  # the first gvfs connect after login is slow, and the sidebar bookmark
  # is enough to get to iCloud Drive.
  if [[ -n $BIN_OMARCHY ]]; then
    "$BIN_OMARCHY" launch nautilus >/dev/null 2>&1 &
  else
    [[ -n $BIN_SETSID && -n $BIN_NAUTILUS ]] || fail "nautilus not found"
    "$BIN_SETSID" "$BIN_NAUTILUS" --new-window >/dev/null 2>&1 &
  fi
  service_running || cmd_start
  mount_dav
  ensure_bookmark
}

cmd_login() {
  if [[ -n $BIN_OMARCHY ]]; then
    "$BIN_OMARCHY" launch tui --app-id=io.github.abort-retry-ignore.ff-drive-login "$HERE/$APP" login-tui
    return
  fi
  if [[ -n $BIN_XDG_TERMINAL ]]; then
    "$BIN_XDG_TERMINAL" -e "$HERE/$APP" login-tui
    return
  fi
  fail "open a terminal and run: $HERE/$APP login-tui"
}

cmd_login_tui() {
  load_config
  local rclone_bin
  rclone_bin=$(find_rclone)
  [[ -n $rclone_bin ]] || fail "rclone not found"
  echo
  echo "Fast Fruit Drive — iCloud sign-in"
  echo
  echo "rclone stores a trust token in ~/.config/rclone/rclone.conf (not in this plugin)."
  echo "The token lasts about 30 days. After that, run Sign in again."
  echo "Use your real Apple ID password + 2FA. App-specific passwords are rejected."
  echo
  if remote_configured "$rclone_bin"; then
    echo "Reconnecting existing remote: $remote"
    echo
    "$rclone_bin" config reconnect "$remote"
  else
    echo "No '$remote' remote yet. In the rclone wizard:"
    echo "  n) New remote"
    echo "  name> icloud"
    echo "  Storage> iclouddrive"
    echo
    "$rclone_bin" config
  fi
  echo
  echo "Done. You can close this terminal. Toggle Fast Fruit Drive on from the bar."
  echo
}

cmd_configure() {
  load_config
  local restart=false
  local key value rname changed=false
  for pair in "$@"; do
    key=${pair%%=*}
    value=${pair#*=}
    case $key in
      cache_max_size)
        valid_size "$value" || fail "invalid cache_max_size: $value"
        [[ $value == "$cache_max_size" ]] || changed=true
        cache_max_size=$value
        ;;
      cache_max_age)
        valid_age "$value" || fail "invalid cache_max_age: $value"
        [[ $value == "$cache_max_age" ]] || changed=true
        cache_max_age=$value
        ;;
      cache_max_age_hours)
        value="${value}h"
        valid_age "$value" || fail "invalid cache_max_age_hours: $value"
        [[ $value == "$cache_max_age" ]] || changed=true
        cache_max_age=$value
        ;;
      remote)
        rname=${value%:}
        valid_remote_name "$rname" || fail "invalid remote name: $value"
        value="${rname}:"
        [[ $value == "$remote" ]] || changed=true
        remote=$value
        ;;
      bind)
        valid_bind "$value" || fail "invalid bind (loopback host only): $value"
        [[ $value == "$bind" ]] || changed=true
        bind=$value
        ;;
      dav_host)
        valid_host "$value" || fail "invalid dav_host: $value"
        [[ $value == "$dav_host" ]] || changed=true
        dav_host=$value
        ;;
      display_name)
        valid_display_name "$value" || fail "invalid display_name: $value"
        [[ $value == "$display_name" ]] || changed=true
        display_name=$value
        ;;
      vfs_cache_mode)
        valid_vfs_mode "$value" || fail "invalid vfs_cache_mode: $value"
        [[ $value == "$vfs_cache_mode" ]] || changed=true
        vfs_cache_mode=$value
        ;;
      restart) restart=$(bool "$value") ;;
      *) fail "unknown configure key: $key" ;;
    esac
  done
  save_config
  if [[ $restart == true && $changed == true ]] && service_running; then
    cmd_restart
  else
    ensure_bookmark
  fi
}

cmd_clear_cache() {
  # Safe, near-instant cache wipe: rclone only reconciles its in-memory VFS
  # index at startup, so the file cache cannot be purged while it runs. Stop
  # the unit, wipe, start, and skip the slow parts (gio mount, bookmark, unit
  # rewrite) — WebDAV is stateless, gio reconnects on its own.
  local was_running=false freed
  freed=$(cache_bytes)
  service_running && was_running=true
  if [[ $was_running == true ]]; then
    [[ -n $BIN_SYSTEMCTL ]] || fail "systemctl not found"
    "$BIN_SYSTEMCTL" --user stop "$UNIT" || fail "could not stop $UNIT"
  fi
  if ! safe_rm_rf "$CACHE_DIR"; then
    if [[ $was_running == true ]]; then
      "$BIN_SYSTEMCTL" --user start "$UNIT" || true
    fi
    fail "refusing to clear unsafe cache path: $CACHE_DIR"
  fi
  if ! ensure_dir "$CACHE_DIR"; then
    if [[ $was_running == true ]]; then
      "$BIN_SYSTEMCTL" --user start "$UNIT" || true
    fi
    fail "refusing to use unsafe cache path: $CACHE_DIR"
  fi
  if [[ $was_running == true ]]; then
    "$BIN_SYSTEMCTL" --user start "$UNIT" || fail "could not start $UNIT"
    wait_for_server || fail "WebDAV did not come back — see: journalctl --user -u $UNIT"
  fi
  echo "Cache cleared: $($NUMFMT --to=iec "$freed") freed from $CACHE_DIR"
}

remove_bookmark() {
  local port
  [[ -f $BOOKMARKS ]] || return 0
  if [[ -f $CONFIG_FILE ]]; then
    load_config
  else
    port=${DEFAULT_BIND##*:}
    dav_uri="dav://${DEFAULT_DAV_HOST}:${port}/"
    old_uri="dav://127.0.0.1:${port}/"
  fi
  rewrite_bookmarks ""
}

remove_nautilus_extension() {
  local dir rc=0
  dir="${XDG_DATA_HOME:-$HOME/.local/share}/nautilus-python/extensions"
  ensure_dir "$dir" 2>/dev/null || return 0
  exec {extfd}<"$dir" 2>/dev/null || return 0
  "$BIN_PYTHON3" - "$extfd" <<'PY' || rc=$?
import os, sys
dirfd = int(sys.argv[1])
try:
    os.unlink("fast_fruit_drive_nautilus.py", dir_fd=dirfd)
except OSError:
    pass
try:
    pycfd = os.open("__pycache__", os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY, dir_fd=dirfd)
except OSError:
    sys.exit(0)
try:
    for entry in os.scandir(pycfd):
        if entry.name.startswith("fast_fruit_drive_nautilus"):
            try:
                os.unlink(entry.name, dir_fd=pycfd)
            except OSError:
                pass
finally:
    os.close(pycfd)
PY
  exec {extfd}<&-
  return $rc
}

cmd_uninstall() {
  cmd_stop
  if [[ -n $BIN_SYSTEMCTL ]]; then
    "$BIN_SYSTEMCTL" --user disable --now "$UNIT" >/dev/null 2>&1 || true
  fi
  local wants_dir
  if ensure_dir "${UNIT_FILE%/*}" 2>/dev/null; then
    if exec {undfd}<"${UNIT_FILE%/*}"; then
      fd_unlink "$undfd" "$UNIT"
      exec {undfd}<&-
    fi
  fi
  wants_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/default.target.wants"
  if ensure_dir "$wants_dir" 2>/dev/null; then
    if exec {wfd}<"$wants_dir"; then
      fd_unlink "$wfd" "$UNIT"
      exec {wfd}<&-
    fi
  fi
  if [[ -n $BIN_SYSTEMCTL ]]; then
    "$BIN_SYSTEMCTL" --user reset-failed "$UNIT" >/dev/null 2>&1 || true
    "$BIN_SYSTEMCTL" --user daemon-reload >/dev/null 2>&1 || true
  fi
  remove_bookmark
  remove_nautilus_extension
  safe_rm_rf "$CONFIG_DIR" || echo "$APP: refusing to delete unsafe path: $CONFIG_DIR" >&2
  safe_rm_rf "$CACHE_DIR" || echo "$APP: refusing to delete unsafe path: $CACHE_DIR" >&2
  echo "$APP: removed unit, bookmark, emblems, $CONFIG_DIR, and $CACHE_DIR"
  echo "$APP: left ~/.config/rclone/rclone.conf untouched (Apple session is rclone's)"
}

cmd_status() {
  load_config
  [[ -n $BIN_JQ ]] || fail "jq not found"
  local rclone_bin running mounted configured gvfs rclone_found cache_used has_session
  rclone_bin=$(find_rclone)
  rclone_found=false
  [[ -n $rclone_bin ]] && rclone_found=true
  configured=false
  if [[ $rclone_found == true ]] && remote_configured "$rclone_bin"; then
    configured=true
  fi
  has_session=false
  if [[ $configured == true ]] && session_present; then
    has_session=true
  fi
  running=false
  service_running && running=true
  mounted=false
  gio_mounted && mounted=true
  gvfs=false
  [[ -x /usr/lib/gvfsd-dav ]] && gvfs=true
  cache_used=$(cache_bytes)
  local ready=false
  [[ $rclone_found == true && $configured == true && $has_session == true && $gvfs == true ]] && ready=true
  local needs_login=false
  [[ $rclone_found == true && ( $configured != true || $has_session != true ) ]] && needs_login=true
  local status_text="Stopped"
  if [[ $rclone_found != true ]]; then
    status_text="rclone not found"
  elif [[ $needs_login == true ]]; then
    status_text="Sign in to iCloud"
  elif [[ $gvfs != true ]]; then
    status_text="install gvfs-dnssd"
  elif [[ $running == true ]]; then
    status_text="Connected"
    [[ $mounted == true ]] || status_text="Serving"
  fi
  $BIN_JQ -n \
    --argjson ok true \
    --argjson ready "$ready" \
    --argjson running "$running" \
    --argjson mounted "$mounted" \
    --argjson rcloneFound "$rclone_found" \
    --argjson remoteConfigured "$configured" \
    --argjson hasSession "$has_session" \
    --argjson needsLogin "$needs_login" \
    --argjson gvfsDav "$gvfs" \
    --argjson cacheUsedBytes "$cache_used" \
    --arg statusText "$status_text" \
    --arg remote "$remote" \
    --arg addr "$bind" \
    --arg uri "$dav_uri" \
    --arg displayName "$display_name" \
    --arg cacheMaxSize "$cache_max_size" \
    --arg cacheMaxAge "$cache_max_age" \
    --arg cachePath "$CACHE_DIR" \
    --arg lastError "" \
    '{
      ok: $ok,
      ready: $ready,
      running: $running,
      mounted: $mounted,
      rcloneFound: $rcloneFound,
      remoteConfigured: $remoteConfigured,
      hasSession: $hasSession,
      needsLogin: $needsLogin,
      gvfsDav: $gvfsDav,
      cacheUsedBytes: $cacheUsedBytes,
      statusText: $statusText,
      remote: $remote,
      addr: $addr,
      uri: $uri,
      displayName: $displayName,
      cacheMaxSize: $cacheMaxSize,
      cacheMaxAge: $cacheMaxAge,
      cachePath: $cachePath,
      lastError: $lastError
    }'
}

resolve_tools

cmd=${1:-help}
shift || true
case $cmd in
  status) cmd_status ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  toggle) cmd_toggle ;;
  open) cmd_open ;;
  login) cmd_login ;;
  login-tui) cmd_login_tui ;;
  serve) cmd_serve ;;
  ensure) cmd_ensure ;;
  configure) cmd_configure "$@" ;;
  clear-cache) cmd_clear_cache ;;
  uninstall) cmd_uninstall ;;
  help|-h|--help) usage ;;
  *) fail "unknown command: $cmd" ;;
esac
