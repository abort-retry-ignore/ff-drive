#!/usr/bin/python3 -I
"""Fast Fruit Drive — rclone iCloud WebDAV helper for the Omarchy widget.

One isolated (`-I`) Python process replaces the previous Bash-plus-embedded
-Python helper. `-I` makes the interpreter ignore every PYTHON* environment
variable and the user site directory, closing the injection path a hostile
PYTHONPATH/PYTHONSTARTUP relied on. There is no shell anywhere in this file:
no BASH_ENV, no quoting, no process substitution.

State (config, systemd unit, GTK bookmark, Nautilus extension copy, WebDAV
credentials, cache) is only ever touched through directory file descriptors
opened component-by-component with O_NOFOLLOW (see `SafeDir`). A path is
validated and used in the same open call; nothing is checked, discarded, and
reopened by name later, so a symlink swap between "check" and "use" cannot
redirect an operation.

The only configurable settings are cache size and cache max age (matching
manifest.json exactly). Remote name, bind address, port, DAV host, display
name and VFS mode are fixed constants: there was never a UI for them, and a
fixed value cannot be pointed at something else.

Every subprocess this script spawns — rclone, gio, systemctl, nautilus,
omarchy, xdg-terminal-exec, and recursive calls to itself — is launched with
an explicit allow-listed environment (`sanitized_child_env`) and, where the
call is untrusted or unbounded, through `run_bounded`, which enforces a
monotonic deadline and a raw-byte ceiling on stdout/stderr *before* any
line-oriented parsing happens, then terminates and reaps the whole process
group. The `__supervise` command applies the same primitive to whole helper
invocations so the QML widget never has to.
"""

from __future__ import annotations

import base64
import hashlib
import http.client
import json
import os
import pwd
import re
import secrets
import select
import signal
import stat
import subprocess
import sys
import time

APP = "fast-fruit-drive"
UNIT_NAME = "fast-fruit-drive.service"

# ---------------------------------------------------------------------
# Fixed identity. None of this is configurable: there is no UI for it, and
# a constant cannot be redirected by a hostile config file.
# ---------------------------------------------------------------------
REMOTE = "icloud:"
REMOTE_NAME = "icloud"
BIND_V4 = "127.0.0.1"
BIND_V6 = "::1"
PORT = 8080
DAV_HOST = "iCloud.localhost"
DISPLAY_NAME = "iCloud Drive"
VFS_CACHE_MODE = "full"
