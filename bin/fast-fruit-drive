# =======================================================================
# Descriptor-relative state handling
#
# Every path component is opened with O_NOFOLLOW relative to an already
# -open, already-validated parent directory descriptor. Validation and use
# happen in the same os.open() call, so there is no window between
# "check" and "use" for a symlink swap to exploit. Writes are atomic
# (O_EXCL temp file + rename, both relative to the same retained fd).
# =======================================================================

class Unsafe(RuntimeError):
    """A path, owner, or permission did not match what we require."""


def _overflow_uid() -> int:
    try:
        with open("/proc/sys/kernel/overflowuid", encoding="ascii") as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return 65534


# Only ever set for the sandboxed 'serve' entry point (see cmd_serve/main).
# systemd applies an unprivileged user namespace to satisfy ProtectSystem=
# strict/ProtectHome=read-only for --user units: our own uid maps through
# unchanged, but every other uid (including root) is remapped to the
# kernel's overflow uid, because it has no mapping inside that namespace.
# The sandbox itself (read-only /usr and /home, closed PATH, no shell,
# NoNewPrivileges) already provides the guarantee the ownership check
# exists for, so 'serve' additionally trusts the overflow uid as standing
# in for root. No other command runs under this sandbox, so no other
# command relaxes this check.
_EXTRA_TRUSTED_UIDS: frozenset = frozenset()


def _trusted_uids() -> frozenset:
    return frozenset({0, os.getuid()}) | _EXTRA_TRUSTED_UIDS


def _valid_component(name: str) -> bool:
    if not name or name in (".", ".."):
        return False
    if "/" in name or "\0" in name:
        return False
    return all(ord(ch) >= 32 for ch in name)


class SafeDir:
    """A directory whose identity is pinned by an open, no-follow fd."""

    __slots__ = ("fd",)

    def __init__(self, fd: int):
        self.fd = fd

    def close(self) -> None:
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None

    def __enter__(self) -> "SafeDir":
        return self

    def __exit__(self, *_exc) -> None:
        self.close()

    @classmethod
    def open_root(cls) -> "SafeDir":
        return cls(os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW))

    def _check_owner_mode(self, st: os.stat_result, allowed_uids) -> None:
        if st.st_uid not in allowed_uids:
            raise Unsafe("unexpected owner")
        if st.st_mode & 0o022:
            raise Unsafe("group- or world-writable")

    def enter(self, name: str, *, create: bool = False, mode: int = 0o700,
              allowed_uids=None) -> "SafeDir":
        if allowed_uids is None:
            allowed_uids = _trusted_uids()
        if not _valid_component(name):
            raise Unsafe(f"unsafe path component: {name!r}")
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        try:
            fd = os.open(name, flags, dir_fd=self.fd)
        except FileNotFoundError:
            if not create:
                raise
            os.mkdir(name, mode, dir_fd=self.fd)
            fd = os.open(name, flags, dir_fd=self.fd)
        except NotADirectoryError as exc:
            raise Unsafe(f"{name} exists and is not a directory") from exc
        try:
            self._check_owner_mode(os.fstat(fd), allowed_uids)
        except Unsafe:
            os.close(fd)
            raise
        return SafeDir(fd)

    def walk(self, path: str, *, create: bool = False,
              allowed_uids=None) -> "SafeDir":
        if allowed_uids is None:
            allowed_uids = _trusted_uids()
        cur: SafeDir = self
        opened: list[SafeDir] = []
        try:
            for part in [p for p in path.strip("/").split("/") if p]:
                nxt = cur.enter(part, create=create, allowed_uids=allowed_uids)
                opened.append(nxt)
                cur = nxt
        except BaseException:
            for d in opened:
                d.close()
            raise
        for d in opened[:-1]:
            d.close()
        return opened[-1] if opened else SafeDir(os.dup(self.fd))

    def atomic_write(self, name: str, data: bytes, mode: int = 0o600) -> None:
        if not _valid_component(name):
            raise Unsafe(f"unsafe filename: {name!r}")
        tmp = ".ff-" + secrets.token_hex(10)
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                     mode, dir_fd=self.fd)
        try:
            with os.fdopen(fd, "wb") as fh:
                fh.write(data)
                fh.flush()
                os.fsync(fh.fileno())
            os.rename(tmp, name, src_dir_fd=self.fd, dst_dir_fd=self.fd)
        except BaseException:
            try:
                os.unlink(tmp, dir_fd=self.fd)
            except OSError:
                pass
            raise
        try:
            os.fsync(self.fd)
        except OSError:
            pass

    def read_bounded(self, name: str, max_bytes: int, *, missing_ok: bool = False,
                      allowed_uids=None) -> "bytes | None":
        if allowed_uids is None:
            allowed_uids = _trusted_uids()
        if not _valid_component(name):
            raise Unsafe(f"unsafe filename: {name!r}")
        try:
            # O_NONBLOCK: a planted FIFO at a fixed registration name must
            # fail the regular-file check below instead of blocking the open.
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=self.fd)
        except FileNotFoundError:
            if missing_ok:
                return None
            raise
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode):
                raise Unsafe(f"{name} is not a regular file")
            self._check_owner_mode(st, allowed_uids)
            if st.st_size > max_bytes:
                raise Unsafe(f"{name} is too large")
            data = bytearray()
            while True:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                data += chunk
                if len(data) > max_bytes:
                    raise Unsafe(f"{name} is too large")
            return bytes(data)
        finally:
            os.close(fd)

    def unlink(self, name: str) -> None:
        try:
            os.unlink(name, dir_fd=self.fd)
        except FileNotFoundError:
            pass

    def unlink_symlink_to(self, name: str, targets) -> bool:
        """Unlink ``name`` only if it is a symlink whose target is one of
        ``targets`` verbatim. Anything else (a regular file, a link that
        points elsewhere, a missing entry) is left untouched."""
        try:
            target = os.readlink(name, dir_fd=self.fd)
        except OSError:  # missing, or not a symlink (EINVAL)
            return False
        if target not in targets:
            return False
        try:
            os.unlink(name, dir_fd=self.fd)
        except FileNotFoundError:
            return False
        return True

    def remove_tree(self, name: str, *, max_entries: int = 200_000, max_depth: int = 64) -> None:
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY, dir_fd=self.fd)
        except FileNotFoundError:
            return
        except NotADirectoryError:
            os.unlink(name, dir_fd=self.fd)
            return
        counter = [0]

        def wipe(dfd: int, depth: int) -> None:
            if depth > max_depth:
                raise Unsafe("tree too deep")
            with os.scandir(dfd) as it:
                entries = list(it)
            for entry in entries:
                counter[0] += 1
                if counter[0] > max_entries:
                    raise Unsafe("tree too large")
                if entry.is_dir(follow_symlinks=False):
                    child = os.open(entry.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY, dir_fd=dfd)
                    try:
                        wipe(child, depth + 1)
                    finally:
                        os.close(child)
                    os.rmdir(entry.name, dir_fd=dfd)
                else:
                    os.unlink(entry.name, dir_fd=dfd)

        try:
            wipe(fd, 0)
        finally:
            os.close(fd)
        os.rmdir(name, dir_fd=self.fd)

    def scandir_names(self):
        with os.scandir(self.fd) as it:
            yield from list(it)


def open_home() -> SafeDir:
    if not HOME.startswith("/"):
        raise Unsafe("unexpected home directory")
    root = SafeDir.open_root()
    try:
        return root.walk(HOME)
    finally:
        root.close()


def ensure_state_dir(rel_path: str) -> SafeDir:
    """Open (creating component-wise as needed) a directory under HOME."""
    with open_home() as home:
        return home.walk(rel_path, create=True)


def open_state_dir(rel_path: str) -> "SafeDir | None":
    try:
        with open_home() as home:
            return home.walk(rel_path)
    except (FileNotFoundError, Unsafe):
        return None


def rel_to_home(path: str) -> str:
    return os.path.relpath(path, HOME)


def _open_expected_plugin_dir() -> SafeDir:
    """Open the one marketplace checkout this plugin is allowed to use.

    This deliberately uses the fixed plugin ID below the passwd-derived home,
    rather than HERE/realpath or any inherited XDG/HOME value. The returned
    descriptor remains valid even if a pathname is swapped after opening.
    """
    with open_home() as home:
        return home.walk(PLUGIN_REL)


def _expected_plugin_dir_is_valid(d: SafeDir) -> bool:
    try:
        raw = d.read_bounded("manifest.json", MANIFEST_CAP)
        manifest = json.loads(raw.decode("utf-8"))
    except (Unsafe, OSError, UnicodeDecodeError, ValueError):
        return False
    return isinstance(manifest, dict) and manifest.get("id") == PLUGIN_ID


def _read_expected_plugin_asset(parts: tuple[str, ...], name: str, max_bytes: int) -> bytes:
    """Read a regular, no-follow asset below the fixed validated checkout."""
    d = _open_expected_plugin_dir()
    opened: list[SafeDir] = []
    try:
        if not _expected_plugin_dir_is_valid(d):
            raise Unsafe("expected plugin manifest is missing or foreign")
        current = d
        for part in parts:
            child = current.enter(part)
            opened.append(child)
            current = child
        return current.read_bounded(name, max_bytes)
    finally:
        for child in reversed(opened):
            child.close()
        d.close()


def install_lifecycle_guard() -> None:
    """Atomically install the independently executable lifecycle guard.

    The source is read via a retained checkout/bin FD only after the fixed
    checkout's manifest ID has been verified. The enabled systemd unit invokes
    this installed copy, never a checkout pathname.
    """
    try:
        source = _read_expected_plugin_asset(("bin",), GUARD_SOURCE_NAME, GUARD_SOURCE_CAP)
    except (FileNotFoundError, OSError, Unsafe) as exc:
        fail(f"cannot safely install lifecycle guard: {exc}")
    if not source.startswith(b"#!"):
        fail("refusing lifecycle guard without an interpreter header")
    d = ensure_state_dir(rel_to_home(CONFIG_DIR))
    try:
        d.atomic_write(GUARD_INSTALLED_NAME, source, 0o700)
    finally:
        d.close()


def _systemd_arg(value: str) -> str:
    """Quote a fixed absolute argument for systemd's ExecStart parser."""
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


# =======================================================================
# Verified tool resolution — closed PATH, root-owned regular executables
# only, symlinks followed at most three hops and only within /usr.
# =======================================================================

_TRUSTED_BASES = ("/usr/bin/", "/usr/local/bin/")
_TRUSTED_LINK_TARGETS = ("/usr/bin/", "/usr/local/bin/", "/usr/lib/", "/usr/share/")


def _root_owned_ancestors(dirpath: str) -> bool:
    try:
        root = SafeDir.open_root()
    except OSError:
        return False
    try:
        root.walk(dirpath, allowed_uids=frozenset({0}) | _EXTRA_TRUSTED_UIDS).close()
        return True
    except (Unsafe, OSError):
        return False
    finally:
        root.close()


def _leaf_is_safe_exec(path: str) -> bool:
    try:
        st = os.lstat(path)
    except OSError:
        return False
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        return False
    if st.st_uid not in (frozenset({0}) | _EXTRA_TRUSTED_UIDS) or st.st_mode & 0o022 or not st.st_mode & 0o111:
        return False
    return True


def verified_exec(path: str) -> "str | None":
    hops = 0
    while True:
        if not path.startswith(_TRUSTED_BASES):
            return None
        try:
            st = os.lstat(path)
        except OSError:
            return None
        if stat.S_ISLNK(st.st_mode):
            hops += 1
            if hops > 3 or st.st_uid not in (frozenset({0}) | _EXTRA_TRUSTED_UIDS):
                return None
            if not _root_owned_ancestors(os.path.dirname(path)):
                return None
            try:
                target = os.readlink(path)
            except OSError:
                return None
            if not target or ".." in target.split("/"):
                return None
            if not target.startswith("/"):
                target = os.path.normpath(os.path.join(os.path.dirname(path), target))
            else:
                target = os.path.normpath(target)
            if not target.startswith(_TRUSTED_LINK_TARGETS):
                return None
            path = target
            continue
        if not _leaf_is_safe_exec(path):
            return None
        if not _root_owned_ancestors(os.path.dirname(path)):
            return None
        return path


def find_verified(name: str) -> "str | None":
    for base in ("/usr/bin", "/usr/local/bin"):
        resolved = verified_exec(f"{base}/{name}")
        if resolved:
            return resolved
    return None


class Tools:
    python3 = ""
    systemctl = ""
    gio = ""
    nautilus = ""
    omarchy = ""
    xdg_terminal = ""
    rclone = ""
    notify_send = ""


def resolve_tools() -> None:
    Tools.python3 = find_verified("python3") or ""
    Tools.systemctl = find_verified("systemctl") or ""
    Tools.gio = find_verified("gio") or ""
    Tools.nautilus = find_verified("nautilus") or ""
    Tools.omarchy = find_verified("omarchy") or ""
    Tools.xdg_terminal = find_verified("xdg-terminal-exec") or ""
    Tools.rclone = find_verified("rclone") or ""
    Tools.notify_send = find_verified("notify-send") or ""


# =======================================================================
# Bounded process execution
#
# Every subprocess is spawned with an explicit allow-listed environment, in
# its own session (so it can be group-killed without touching our caller),
# and — for run_bounded callers — with raw stdout/stderr capped in bytes
# *before* any line parsing, plus a monotonic deadline. On timeout or
# overflow the whole process group is TERM'd, then KILL'd, and reaped.
# =======================================================================

_ENV_KEEP_EXACT = frozenset({
    "HOME", "USER", "LOGNAME", "LANG", "TZ",
    "XDG_RUNTIME_DIR", "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP",
    "DBUS_SESSION_BUS_ADDRESS", "WAYLAND_DISPLAY", "DISPLAY",
    "HYPRLAND_INSTANCE_SIGNATURE",
})


def sanitized_child_env(extra: "dict | None" = None) -> dict:
    env = {"PATH": "/usr/bin"}
    for key, value in os.environ.items():
        if key in _ENV_KEEP_EXACT or key.startswith("LC_"):
            env[key] = value
    if extra:
        env.update(extra)
    return env


class BoundedResult:
    def __init__(self, returncode: int, stdout: bytes, stderr: bytes, *,
                 timed_out: bool = False, overflowed: bool = False):
        self.returncode = returncode
        self.stdout = stdout
        self.stderr = stderr
        self.timed_out = timed_out
        self.overflowed = overflowed

    @property
    def ok(self) -> bool:
        return self.returncode == 0 and not self.timed_out and not self.overflowed


def _killpg(proc: subprocess.Popen, *, force: bool) -> None:
    try:
        pgid = os.getpgid(proc.pid)
    except (ProcessLookupError, OSError):
        return
    try:
        os.killpg(pgid, signal.SIGKILL if force else signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        pass


def run_bounded(argv, *, timeout: float, cap: int = OUTPUT_CAP,
                input_bytes: "bytes | None" = None, env: "dict | None" = None) -> BoundedResult:
    proc = subprocess.Popen(
        argv,
        stdin=subprocess.PIPE if input_bytes is not None else subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env if env is not None else sanitized_child_env(),
        start_new_session=True,
        close_fds=True,
    )
    out = bytearray()
    err = bytearray()
    overflowed = False
    timed_out = False
    pipes = {proc.stdout.fileno(): ("out", proc.stdout), proc.stderr.fileno(): ("err", proc.stderr)}
    for fh in (proc.stdout, proc.stderr):
        os.set_blocking(fh.fileno(), False)
    if input_bytes is not None:
        try:
            proc.stdin.write(input_bytes)
        except (BrokenPipeError, OSError):
            pass
        finally:
            try:
                proc.stdin.close()
            except OSError:
                pass

    deadline = time.monotonic() + timeout
    open_fds = set(pipes)
    try:
        while open_fds:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                break
            ready, _, _ = select.select(list(open_fds), [], [], min(remaining, 0.25))
            for fd in ready:
                which, _fh = pipes[fd]
                try:
                    chunk = os.read(fd, 65536)
                except OSError:
                    chunk = b""
                if not chunk:
                    open_fds.discard(fd)
                    continue
                target = out if which == "out" else err
                if len(target) < cap:
                    target.extend(chunk[: cap - len(target)])
                if len(target) >= cap:
                    overflowed = True
            if overflowed:
                break
        if timed_out or overflowed:
            _killpg(proc, force=False)
    finally:
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            _killpg(proc, force=True)
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                pass
        for fh in (proc.stdout, proc.stderr):
            try:
                fh.close()
            except OSError:
                pass
        if proc.stdin is not None:
            try:
                proc.stdin.close()
            except OSError:
                pass

    return BoundedResult(proc.returncode or 0, bytes(out), bytes(err),
                         timed_out=timed_out, overflowed=overflowed)


def spawn_detached(argv, env: "dict | None" = None) -> None:
    """Fire-and-forget a process (terminal, file manager) in its own
    session so it outlives and is never reaped or signalled by us."""
    subprocess.Popen(
        argv,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=env if env is not None else sanitized_child_env(),
        start_new_session=True,
        close_fds=True,
    )


# =======================================================================
# Config — cache size and cache max age only. Everything else is fixed.
# =======================================================================

def valid_cache_size(value: str) -> bool:
    return value in CACHE_SIZE_CHOICES


def valid_cache_age_hours(value: str) -> bool:
    if not re.fullmatch(r"[0-9]{1,4}", value):
        return False
    return MIN_CACHE_MAX_AGE_HOURS <= int(value) <= MAX_CACHE_MAX_AGE_HOURS


class Config:
    cache_max_size = DEFAULT_CACHE_MAX_SIZE
    cache_max_age_hours = DEFAULT_CACHE_MAX_AGE_HOURS

    @property
    def cache_max_age(self) -> str:
        return f"{self.cache_max_age_hours}h"


def load_config() -> Config:
    cfg = Config()
    cfg.cache_max_size = DEFAULT_CACHE_MAX_SIZE
    cfg.cache_max_age_hours = DEFAULT_CACHE_MAX_AGE_HOURS
    d = open_state_dir(rel_to_home(CONFIG_DIR))
    if d is None:
        return cfg
    try:
        try:
            data = d.read_bounded("config", 65536, missing_ok=True)
        except Unsafe as exc:
            print(f"{APP}: {exc}, using defaults", file=sys.stderr)
            return cfg
        if data is None:
            return cfg
        legacy_age = None
        for line in data.decode("utf-8", "replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.partition("=")
            key, value = key.strip(), value.strip()
            if key == "cache_max_size":
                if valid_cache_size(value):
                    cfg.cache_max_size = value
                else:
                    print(f"{APP}: invalid cache_max_size '{value}' in config, using default", file=sys.stderr)
            elif key == "cache_max_age_hours":
                if valid_cache_age_hours(value):
                    cfg.cache_max_age_hours = int(value)
                else:
                    print(f"{APP}: invalid cache_max_age_hours '{value}' in config, using default", file=sys.stderr)
            elif key == "cache_max_age":
                # Pre-0.2 configs stored a duration string; migrate hours only.
                m = re.fullmatch(r"([0-9]{1,4})h", value)
                if m and valid_cache_age_hours(m.group(1)):
                    legacy_age = int(m.group(1))
            # Any other legacy key (remote/bind/dav_host/display_name/
            # vfs_cache_mode/addr) is intentionally dropped: those are now
            # fixed constants, not configurable, and self-heal on next save.
        if legacy_age is not None and cfg.cache_max_age_hours == DEFAULT_CACHE_MAX_AGE_HOURS:
            cfg.cache_max_age_hours = legacy_age
        return cfg
    finally:
        d.close()


def save_config(cfg: Config) -> None:
    d = ensure_state_dir(rel_to_home(CONFIG_DIR))
    try:
        body = (
            f"cache_max_size={cfg.cache_max_size}\n"
            f"cache_max_age_hours={cfg.cache_max_age_hours}\n"
        )
        d.atomic_write("config", body.encode("ascii"), 0o600)
    finally:
        d.close()


# =======================================================================
# rclone remote / session checks
# =======================================================================

def remote_configured() -> bool:
    if not Tools.rclone:
        return False
    result = run_bounded([Tools.rclone, "listremotes"], timeout=5, env=sanitized_child_env())
    if not result.ok:
        return False
    names = {line.strip().rstrip(":") for line in result.stdout.decode("utf-8", "replace").splitlines()}
    return REMOTE_NAME in names


def _read_session() -> "tuple[str, str] | None":
    """(trust_token, cookies) from rclone's config, or None if there is no
    readable icloud remote. Presence only: this says nothing about validity."""
    import configparser

    d = open_state_dir(rel_to_home(RCLONE_CONF_DIR))
    if d is None:
        return None
    try:
        try:
            data = d.read_bounded("rclone.conf", 1_048_576, missing_ok=True)
        except Unsafe:
            return None
        if data is None:
            return None
        parser = configparser.ConfigParser()
        try:
            parser.read_string(data.decode("utf-8", "replace"))
        except configparser.Error:
            return None
        if not parser.has_section(REMOTE_NAME):
            return None
        return (parser.get(REMOTE_NAME, "trust_token", fallback="").strip(),
                parser.get(REMOTE_NAME, "cookies", fallback="").strip())
    finally:
        d.close()


def session_present() -> bool:
    session = _read_session()
    return bool(session and (session[0] or session[1]))


def session_fingerprint() -> str:
    """Identifies the credential a probe result belongs to, so a new sign-in
    invalidates the cached verdict by itself. Only the long-lived trust token
    is used (cookies are rewritten by rclone as it runs); never the secret."""
    session = _read_session()
    if not session or not (session[0] or session[1]):
        return ""
    return hashlib.sha256((session[0] or session[1]).encode("utf-8", "replace")).hexdigest()


# -----------------------------------------------------------------------
# Session *validity*
#
# A trust token being present in rclone.conf says nothing about whether
# iCloud still honours it (it lapses after ~30 days). rclone only finds out
# when it calls iCloud, and then the local WebDAV server answers 207 with a
# truncated body, which GVFS reports as a failed mount and Nautilus turns
# into a bogus password prompt. So validity is probed against iCloud itself.
# -----------------------------------------------------------------------

SESSION_CHECK_FILE = "session-check"
SESSION_OK_TTL = 600.0       # re-verify a good session this often (while running)
SESSION_BAD_TTL = 120.0      # re-verify an expired/unknown verdict this often
SESSION_PENDING_TTL = 60.0   # a background probe is assumed dead after this
SESSION_PROBE_TIMEOUT = 25.0
SESSION_EXPIRED_MESSAGE = "iCloud session expired \u2014 use Sign in on the widget"
SESSION_PCS_MESSAGE = ("iCloud sign-in incomplete \u2014 open icloud.com in a browser and accept any "
                       "Terms & Conditions, then use Sign in again")
# Verdicts that mean "the stored login cannot reach iCloud Drive":
#   expired - iCloud rejected the session (trust token lapsed, ~30 days)
#   pcs     - signed in, but Apple withheld the web session cookies
#             (X-APPLE-WEBAUTH-TOKEN). Known causes: iCloud Terms & Conditions
#             not yet accepted at icloud.com, or "Access iCloud Data on the
#             Web" switched off (Advanced Data Protection). rclone issue #9658.
BAD_SESSION_STATES = ("expired", "pcs")
_SESSION_PCS_RE = re.compile(
    r"requestpcs|missing (?:x-apple-webauth-token|pcs cookies)", re.IGNORECASE)
_SESSION_EXPIRED_RE = re.compile(
    r"invalid global session|http error (?:401|403|421)\b|requires? 2fa|two-factor|"
    r"authentication (?:failed|required)|trust token|config reconnect",
    re.IGNORECASE,
)


def probe_session() -> str:
    """Ask iCloud, via rclone, whether the stored session still works.

    Returns "ok", "expired" (iCloud rejected it), "pcs" (signed in but no
    web-access cookies were issued) or "unknown" (offline, timeout, anything
    that is not clearly an auth problem)."""
    if not Tools.rclone:
        return "unknown"
    result = run_bounded(
        [Tools.rclone, "lsd", REMOTE,
         "--retries", "1", "--low-level-retries", "1",
         "--contimeout", "8s", "--timeout", "12s"],
        timeout=SESSION_PROBE_TIMEOUT,
    )
    if result.timed_out or result.overflowed:
        return "unknown"
    if result.returncode == 0:
        return "ok"
    text = (result.stderr + b"\n" + result.stdout).decode("utf-8", "replace")
    if _SESSION_PCS_RE.search(text):
        return "pcs"
    return "expired" if _SESSION_EXPIRED_RE.search(text) else "unknown"


def _load_session_check() -> dict:
    d = open_state_dir(rel_to_home(CONFIG_DIR))
    if d is None:
        return {}
    try:
        try:
            data = d.read_bounded(SESSION_CHECK_FILE, 4096, missing_ok=True)
        except (Unsafe, OSError):
            return {}
        if not data:
            return {}
        try:
            record = json.loads(data)
        except ValueError:
            return {}
        return record if isinstance(record, dict) else {}
    finally:
        d.close()


def _store_session_check(record: dict) -> None:
    d = open_state_dir(rel_to_home(CONFIG_DIR))
    if d is None:
        return
    try:
        d.atomic_write(SESSION_CHECK_FILE, json.dumps(record).encode("utf-8"))
    except (Unsafe, OSError):
        pass
    finally:
        d.close()


def drop_dav_entry() -> None:
    """Take the mount and the sidebar bookmark away: with a dead session
    every click on them only produces a password prompt for a credential the
    user never has."""
    try:
        # Only our own URI. unmount_dav() also sweeps the generic legacy
        # loopback URIs, which could be someone else's WebDAV volume; that
        # sweep belongs to removal of the plugin, not to a routine expiry.
        if Tools.gio:
            run_bounded([Tools.gio, "mount", "-u", DAV_URI], timeout=5)
        remove_bookmark()
    except (Unsafe, OSError):
        pass


# Fixed texts only (nothing from rclone or Apple is ever put in a notification).
_SESSION_NOTICES = {
    "expired": (
        "iCloud session expired",
        "Choose Reconnect iCloud in the Fast Fruit Drive panel and sign in with your Apple ID and 2FA.",
    ),
    "pcs": (
        "iCloud sign-in incomplete",
        "Apple is not giving this sign-in access to iCloud Drive. Open icloud.com in a browser and "
        "accept any Terms & Conditions, then choose Reconnect iCloud in the Fast Fruit Drive panel.",
    ),
}


def notify_session_problem(state: str) -> None:
    notice = _SESSION_NOTICES.get(state)
    if not notice or not Tools.notify_send:
        return
    run_bounded(
        [Tools.notify_send, "--app-name=Fast Fruit Drive", "--urgency=normal",
         "--icon=dialog-warning", "--", notice[0], notice[1]],
        timeout=5,
    )


def refresh_session(*, notify: bool = True) -> str:
    """Probe now, remember the verdict, and on a bad one remove the DAV entry
    and tell the user, once per (credential, verdict)."""
    previous = _load_session_check()
    state = probe_session()
    fingerprint = session_fingerprint()
    same = previous.get("fp") == fingerprint
    record = {"fp": fingerprint, "result": state, "checked": int(time.time())}
    already_told = same and previous.get("notified") == state
    if state in BAD_SESSION_STATES:
        record["notified"] = state
    elif state == "unknown" and same and previous.get("notified"):
        # A flaky probe must not make the next bad verdict notify again.
        record["notified"] = previous["notified"]
    _store_session_check(record)
    if state in BAD_SESSION_STATES:
        drop_dav_entry()
        if notify and not already_told:
            notify_session_problem(state)
    return state


def fresh_session_state(*, notify: bool = True) -> str:
    """"missing" | "expired" | "pcs" | "ok" | "unknown", from a live probe."""
    if not session_present():
        return "missing"
    return refresh_session(notify=notify)


def require_valid_session() -> None:
    state = fresh_session_state()
    if state == "missing":
        fail("iCloud session missing \u2014 use Sign in on the widget")
    if state == "expired":
        fail(SESSION_EXPIRED_MESSAGE)
    if state == "pcs":
        fail(SESSION_PCS_MESSAGE)


def cached_session_state(*, allow_probe: bool) -> str:
    """"ok" | "expired" | "pcs" | "unknown" without ever touching the network.

    Used by `status`, which runs every few seconds under a hard deadline. A
    stale verdict triggers a detached background probe (at most one at a
    time) instead of blocking; the next status call sees its result."""
    fingerprint = session_fingerprint()
    if not fingerprint:
        return "unknown"
    record = _load_session_check()
    same = record.get("fp") == fingerprint
    result = record.get("result") if same else "unknown"
    if result not in ("ok",) + BAD_SESSION_STATES:
        result = "unknown"
    checked = record.get("checked") if same else 0
    now = time.time()
    if not isinstance(checked, (int, float)) or checked > now:
        checked = 0
    stale = now - checked >= (SESSION_OK_TTL if result == "ok" else SESSION_BAD_TTL)
    if not (stale and allow_probe and Tools.python3):
        return result
    pending = record.get("pending")
    if isinstance(pending, (int, float)) and 0 <= now - pending < SESSION_PENDING_TTL:
        return result
    marker = dict(record) if same else {}
    marker.update({"fp": fingerprint, "pending": int(now)})
    _store_session_check(marker)
    spawn_detached([Tools.python3, "-I", SELF_PATH, "__check-session"])
    return result


def cmd_check_session(_args) -> None:
    """Hidden: refresh the cached session verdict (spawned by `status`)."""
    if session_present():
        refresh_session()


# =======================================================================
# WebDAV authentication
#
# A random per-install credential lives in CONFIG_DIR, owner-only. rclone
# is handed only the htpasswd hash, via an inherited directory fd, never a
# path that could be swapped later. GVFS gets the plaintext through
# Gio.MountOperation, in memory: never the URI, argv, bookmark, or journal.
# Before the password is ever supplied to GVFS, the listener is proven to
# be owned by the current systemd MainPID running the verified rclone
# binary with authenticated arguments.
# =======================================================================

WEBDAV_PASSWORD_FILE = "webdav-password"
WEBDAV_HTPASSWD_FILE = "webdav.htpasswd"
MAX_SECRET = 256
PASSWORD_RE = re.compile(r"[A-Za-z0-9_-]{40,128}\Z")
IPV4_LOOPBACK_HEX = "0100007F"
IPV6_LOOPBACK_HEX = "00000000000000000000000001000000"


class AuthError(RuntimeError):
    pass


def _expected_htpasswd(password: str) -> bytes:
    digest = base64.b64encode(hashlib.sha1(password.encode()).digest()).decode()
    return f"{WEBDAV_USER}:{{SHA}}{digest}\n".encode()


def _password_from_dir(d: SafeDir, *, create: bool) -> str:
    raw = d.read_bounded(WEBDAV_PASSWORD_FILE, MAX_SECRET, missing_ok=create,
                          allowed_uids=frozenset({os.getuid()}))
    if raw is None:
        password = secrets.token_urlsafe(32)
        d.atomic_write(WEBDAV_PASSWORD_FILE, (password + "\n").encode(), 0o600)
        return password
    try:
        password = raw.decode("ascii").strip()
    except UnicodeDecodeError as exc:
        raise AuthError("invalid local WebDAV password") from exc
    if not PASSWORD_RE.fullmatch(password):
        raise AuthError("invalid local WebDAV password")
    return password


def ensure_webdav_auth() -> None:
    d = ensure_state_dir(rel_to_home(CONFIG_DIR))
    try:
        password = _password_from_dir(d, create=True)
        d.atomic_write(WEBDAV_HTPASSWD_FILE, _expected_htpasswd(password), 0o600)
    finally:
        d.close()


def validate_webdav_auth(d: SafeDir) -> str:
    password = _password_from_dir(d, create=False)
    actual = d.read_bounded(WEBDAV_HTPASSWD_FILE, MAX_SECRET,
                             allowed_uids=frozenset({os.getuid()}))
    if actual != _expected_htpasswd(password):
        raise AuthError("local WebDAV credentials do not match")
    return password


def _socket_inodes(pid: int) -> set:
    result = set()
    try:
        with os.scandir(f"/proc/{pid}/fd") as it:
            for count, entry in enumerate(it):
                if count >= 8192:
                    raise AuthError("service has too many file descriptors")
                try:
                    target = os.readlink(entry.path)
                except OSError:
                    continue
                if target.startswith("socket:[") and target.endswith("]"):
                    result.add(target[8:-1])
    except OSError as exc:
        raise AuthError("cannot inspect service sockets") from exc
    return result


def _table_listener_inode(table: str, address: str, port: int) -> "str | None":
    expected = f"{address}:{port:04X}"
    try:
        with open(table, encoding="ascii") as fh:
            next(fh, None)
            for line in fh:
                fields = line.split()
                if len(fields) > 9 and fields[1].upper() == expected and fields[3] == "0A":
                    return fields[9]
    except OSError:
        return None
    return None


def listener_owned(pid: int, rclone_bin: str) -> None:
    if pid <= 1:
        raise AuthError("invalid service identity")
    try:
        exe = os.path.realpath(f"/proc/{pid}/exe")
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            cmdline = fh.read(8192).split(b"\0")
    except OSError as exc:
        raise AuthError("service process disappeared") from exc
    if exe != os.path.realpath(rclone_bin):
        raise AuthError("listener is not the expected rclone process")
    if b"serve" not in cmdline or b"webdav" not in cmdline or b"--htpasswd" not in cmdline:
        raise AuthError("rclone service is missing authenticated WebDAV arguments")
    index = cmdline.index(b"--htpasswd")
    if index + 1 >= len(cmdline):
        raise AuthError("rclone service has no htpasswd value")
    htpasswd_arg = cmdline[index + 1]
    if not htpasswd_arg.startswith(b"/proc/self/fd/") or not htpasswd_arg.endswith(b"/" + WEBDAV_HTPASSWD_FILE.encode()):
        raise AuthError("rclone service has an unexpected htpasswd source")
    expected = {
        _table_listener_inode("/proc/net/tcp", IPV4_LOOPBACK_HEX, PORT),
        _table_listener_inode("/proc/net/tcp6", IPV6_LOOPBACK_HEX, PORT),
    }
    if None in expected or not expected.issubset(_socket_inodes(pid)):
        raise AuthError("WebDAV listeners are not owned by the service MainPID")


def authenticated_options(password: str) -> bool:
    token = base64.b64encode(f"{WEBDAV_USER}:{password}".encode()).decode()
    conn = http.client.HTTPConnection(BIND_V4, PORT, timeout=0.4)
    try:
        conn.request("OPTIONS", "/", headers={"Authorization": f"Basic {token}"})
        response = conn.getresponse()
        response.read(1024)
        return response.status == 200
    except OSError:
        return False
    finally:
        conn.close()


def wait_webdav_ready(pid: int, rclone_bin: str) -> None:
    d = open_state_dir(rel_to_home(CONFIG_DIR))
    if d is None:
        fail("config directory missing")
    try:
        password = validate_webdav_auth(d)
    except AuthError as exc:
        fail(str(exc))
    finally:
        d.close()
    for _ in range(40):
        try:
            listener_owned(pid, rclone_bin)
        except AuthError:
            pass
        else:
            if authenticated_options(password):
                return
        time.sleep(0.15)
    fail("authenticated WebDAV service did not become ready")


def mount_dav(pid: int, rclone_bin: str) -> None:
    d = open_state_dir(rel_to_home(CONFIG_DIR))
    if d is None:
        fail("config directory missing")
    try:
        password = validate_webdav_auth(d)
    except AuthError as exc:
        fail(str(exc))
    finally:
        d.close()
    try:
        listener_owned(pid, rclone_bin)
    except AuthError as exc:
        fail(str(exc))
    if not authenticated_options(password):
        fail("authenticated WebDAV readiness check failed")

    from gi.repository import Gio, GLib  # noqa: E402  (import here: only mount needs GObject)

    loop = GLib.MainLoop()
    result = {"ok": False, "error": None}
    operation = Gio.MountOperation()
    cancellable = Gio.Cancellable()
    operation.set_username(WEBDAV_USER)
    operation.set_password(password)
    operation.set_password_save(Gio.PasswordSave.NEVER)

    def ask_password(op, *_a):
        op.set_username(WEBDAV_USER)
        op.set_password(password)
        op.set_password_save(Gio.PasswordSave.NEVER)
        op.reply(Gio.MountOperationResult.HANDLED)

    def done(source, async_result):
        try:
            source.mount_enclosing_volume_finish(async_result)
            result["ok"] = True
        except GLib.Error as exc:
            if exc.matches(Gio.io_error_quark(), Gio.IOErrorEnum.ALREADY_MOUNTED):
                result["ok"] = True
            else:
                result["error"] = str(exc)
        loop.quit()

    def timeout():
        cancellable.cancel()
        loop.quit()
        return False

    operation.connect("ask-password", ask_password)
    gfile = Gio.File.new_for_uri(DAV_URI)
    gfile.mount_enclosing_volume(Gio.MountMountFlags.NONE, operation, cancellable, done)
    GLib.timeout_add_seconds(10, timeout)
    loop.run()
    try:
        listener_owned(pid, rclone_bin)
    except AuthError as exc:
        fail(str(exc))
    if not result["ok"]:
        fail(result["error"] or "timed out mounting authenticated WebDAV")


# =======================================================================
# systemd unit / GTK bookmark / Nautilus extension
# =======================================================================

# -----------------------------------------------------------------------
# Registration ownership
#
# The units and the Nautilus extension live at fixed names inside directories
# shared with everything else the user runs. This plugin therefore only ever
# overwrites, disables, stops or deletes a registration it can positively
# identify as its own:
#
#   * files it writes start with OWNER_MARKER (naming the plugin ID) and are
#     bound to this installation: units must run the guard copy under this
#     account's config dir / watch this account's plugin checkout;
#   * registrations written by earlier releases carry no marker, so they are
#     recognised by their exact generated shape (Description= plus an
#     ExecStart=/Unit= line pointing at us). They are migrated by the first
#     write, which adds the marker.
#
# Anything else at those names -- a different file, a symlink, a FIFO, a file
# owned by someone else, or oversized data -- is foreign: install refuses and
# leaves it byte-for-byte alone, and removal skips it (and never touches the
# systemd state of a unit it did not write).
#
# bin/fast-fruit-drive-guard.py carries an independent copy of this logic
# because it must keep working after this checkout is gone; the tests assert
# both implementations classify the same fixtures identically.
# -----------------------------------------------------------------------

UNIT_FILES = (UNIT_NAME, LIFECYCLE_SERVICE_NAME, LIFECYCLE_PATH_NAME)
# Units with an [Install] section (the oneshot lifecycle service has none).
ENABLED_UNITS = (UNIT_NAME, LIFECYCLE_PATH_NAME)
_UNIT_DESCRIPTIONS = {
    UNIT_NAME: "Fast Fruit Drive \u2014 rclone iCloud WebDAV for Nautilus",
    LIFECYCLE_SERVICE_NAME: "Fast Fruit Drive removal lifecycle check",
    LIFECYCLE_PATH_NAME: "Watch Fast Fruit Drive checkout removal",
}
_LEGACY_EXTENSION_HEADER = (
    '"""\nFast Fruit Drive \u2014 Nautilus emblems for iCloud WebDAV cache/upload state.\n'
).encode("utf-8")


def _unit_bound_to_install(name: str, lines: "list[str]", *, legacy: bool) -> bool:
    guard = _systemd_arg(GUARD_INSTALLED)
    if name == UNIT_NAME:
        if f"ExecStart=/usr/bin/python3 -I {guard} serve" in lines:
            return True
        # 0.2.0 and earlier ran the checkout helper directly.
        return legacy and f"SyslogIdentifier={APP}" in lines and any(
            line.startswith("ExecStart=/") and line.endswith(f"/{APP} serve") for line in lines
        )
    if name == LIFECYCLE_SERVICE_NAME:
        return f"ExecStart=/usr/bin/python3 -I {guard} lifecycle-check" in lines
    if name == LIFECYCLE_PATH_NAME:
        return f"Unit={LIFECYCLE_SERVICE_NAME}" in lines and f"PathChanged={PLUGIN_CHECKOUT}" in lines
    return False


def unit_is_ours(name: str, data: bytes) -> bool:
    """Whether ``data`` is a unit this installation of the plugin wrote."""
    try:
        lines = data.decode("utf-8").splitlines()
    except UnicodeDecodeError:
        return False
    description = _UNIT_DESCRIPTIONS.get(name)
    if description is None or f"Description={description}" not in lines:
        return False
    marked = bool(lines) and lines[0].startswith("# Managed-By:")
    if marked and lines[0] != OWNER_MARKER:
        return False  # explicitly claimed by something else
    return _unit_bound_to_install(name, lines, legacy=not marked)


def extension_is_ours(data: bytes) -> bool:
    """Whether ``data`` is a Nautilus extension this plugin shipped."""
    return data.startswith(OWNER_MARKER.encode("utf-8") + b"\n") or data.startswith(_LEGACY_EXTENSION_HEADER)


def inspect_registration(d: SafeDir, name: str, cap: int, is_ours) -> "tuple[str, bytes | None]":
    """Classify ``name`` under the pinned directory ``d``.

    Returns ``("missing"|"ours"|"foreign", data)``. Every way the entry can
    fail to be a plain, trusted, bounded regular file (symlink, FIFO, wrong
    owner, group/world-writable, oversized, unreadable) is "foreign": fail
    closed, never follow.
    """
    try:
        data = d.read_bounded(name, cap, missing_ok=True)
    except (Unsafe, OSError):
        return "foreign", None
    if data is None:
        return "missing", None
    return ("ours" if is_ours(data) else "foreign"), data


def _unit_predicate(name: str):
    return lambda data: unit_is_ours(name, data)


def _refuse_foreign(path: str) -> "None":
    fail(
        f"refusing to overwrite {path}: it was not installed by Fast Fruit Drive ({PLUGIN_ID}). "
        "Move it aside, then toggle Fast Fruit Drive on again."
    )


def check_registration_ownership() -> None:
    """Fail before anything is written if a fixed-name registration is foreign.

    ``write_unit`` and ``install_nautilus_extension`` repeat the check against
    their own pinned directory descriptor immediately before writing; this
    early pass just keeps a refused install from leaving partial state.
    """
    d = open_state_dir(rel_to_home(UNIT_DIR))
    if d is not None:
        try:
            for name in UNIT_FILES:
                if inspect_registration(d, name, UNIT_CAP, _unit_predicate(name))[0] == "foreign":
                    _refuse_foreign(os.path.join(UNIT_DIR, name))
        finally:
            d.close()
    d = open_state_dir(rel_to_home(EXTENSION_DIR))
    if d is not None:
        try:
            if inspect_registration(d, EXTENSION_NAME, EXTENSION_CAP, extension_is_ours)[0] == "foreign":
                _refuse_foreign(os.path.join(EXTENSION_DIR, EXTENSION_NAME))
        finally:
            d.close()


def write_unit(*, enable: bool = True) -> None:
    d = ensure_state_dir(rel_to_home(UNIT_DIR))
    try:
        # Check all three before writing any, so a refusal never leaves a
        # half-replaced set of units behind.
        for name in UNIT_FILES:
            if inspect_registration(d, name, UNIT_CAP, _unit_predicate(name))[0] == "foreign":
                _refuse_foreign(os.path.join(UNIT_DIR, name))
        unit = f"""\
{OWNER_MARKER}
[Unit]
Description=Fast Fruit Drive \u2014 rclone iCloud WebDAV for Nautilus
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I {_systemd_arg(GUARD_INSTALLED)} serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group
Environment=PATH=/usr/bin
UnsetEnvironment=BASH_ENV ENV PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONINSPECT LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GIO_EXTRA_MODULES GI_TYPELIB_PATH GSETTINGS_BACKEND GIO_USE_VFS
NoNewPrivileges=yes
UMask=0077
LimitNOFILE=65536
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={CACHE_DIR}
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
SyslogIdentifier={APP}

[Install]
WantedBy=default.target
"""
        lifecycle_service = f"""\
{OWNER_MARKER}
[Unit]
Description=Fast Fruit Drive removal lifecycle check

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I {_systemd_arg(GUARD_INSTALLED)} lifecycle-check
Environment=PATH=/usr/bin
UnsetEnvironment=BASH_ENV ENV PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONINSPECT LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GIO_EXTRA_MODULES GI_TYPELIB_PATH GSETTINGS_BACKEND GIO_USE_VFS
NoNewPrivileges=yes
UMask=0077
"""
        lifecycle_path = f"""\
{OWNER_MARKER}
[Unit]
Description=Watch Fast Fruit Drive checkout removal

[Path]
PathChanged={PLUGIN_CHECKOUT}
PathChanged={os.path.join(PLUGIN_CHECKOUT, "manifest.json")}
Unit={LIFECYCLE_SERVICE_NAME}

[Install]
WantedBy=default.target
"""
        d.atomic_write(UNIT_NAME, unit.encode("utf-8"), 0o644)
        d.atomic_write(LIFECYCLE_SERVICE_NAME, lifecycle_service.encode("utf-8"), 0o644)
        d.atomic_write(LIFECYCLE_PATH_NAME, lifecycle_path.encode("utf-8"), 0o644)
    finally:
        d.close()
    if not Tools.systemctl:
        fail("systemctl not found")
    run_bounded([Tools.systemctl, "--user", "daemon-reload"], timeout=10)
    if enable:
        run_bounded([Tools.systemctl, "--user", "enable", UNIT_NAME], timeout=10)
    # The watcher is the independent removal fallback. It is safe to enable
    # during legacy migration even when the old main unit itself was disabled:
    # its sole executable is the installed guard, and it removes itself after
    # cleanup. Restart refreshes Path= directives after updates.
    run_bounded([Tools.systemctl, "--user", "enable", LIFECYCLE_PATH_NAME], timeout=10)
    run_bounded([Tools.systemctl, "--user", "restart", LIFECYCLE_PATH_NAME], timeout=10)


def _bookmark_is_ours(line: str) -> bool:
    """Exact-URI test for this plugin's own GTK bookmark line.

    The current URI is unique to this plugin (user ff-drive at
    iCloud.localhost). The generic loopback URIs earlier releases used could
    just as well be someone else's WebDAV server, so those only count when the
    label is one this plugin wrote. A label alone never identifies a bookmark.
    """
    uri, _, label = line.partition(" ")
    if uri == DAV_URI:
        return True
    legacy = (LEGACY_URI_NO_USER, LEGACY_URI_OLD_HOST_AUTH, LEGACY_URI_OLD_HOST)
    return uri in legacy and label.strip() in (DISPLAY_NAME, "iCloud WebDAV")


def rewrite_bookmarks(append: "str | None") -> None:
    d = ensure_state_dir(rel_to_home(BOOKMARKS_DIR))
    try:
        existing = d.read_bounded("bookmarks", 1_048_576, missing_ok=True)
        lines = existing.decode("utf-8", "replace").splitlines() if existing else []
        keep = [line for line in lines if not _bookmark_is_ours(line)]
        if append:
            keep.append(append)
        data = ("\n".join(keep) + "\n").encode("utf-8", "replace") if keep else b""
        d.atomic_write("bookmarks", data, 0o600)
    finally:
        d.close()


def ensure_bookmark() -> None:
    # With a known-bad login every click on the entry can only end in a
    # password prompt (or a dead link), so never put it in the sidebar.
    if cached_session_state(allow_probe=False) in BAD_SESSION_STATES:
        return
    rewrite_bookmarks(f"{DAV_URI} {DISPLAY_NAME}")


def remove_bookmark() -> None:
    rewrite_bookmarks(None)


def install_nautilus_extension() -> None:
    # Read source relative to a validated fixed plugin checkout. A direct
    # os.path.isfile/open() pair would re-resolve a mutable pathname after a
    # check and could follow a substituted source link.
    try:
        data = _read_expected_plugin_asset(("nautilus",), EXTENSION_NAME, EXTENSION_CAP)
    except (FileNotFoundError, OSError, Unsafe) as exc:
        fail(f"cannot safely read Nautilus extension source: {exc}")
    if not data.startswith(OWNER_MARKER.encode("utf-8") + b"\n"):
        # Never install a file we could not later recognise as ours.
        fail("refusing Nautilus extension source without its ownership marker")

    d = ensure_state_dir(rel_to_home(EXTENSION_DIR))
    try:
        state, existing = inspect_registration(d, EXTENSION_NAME, EXTENSION_CAP, extension_is_ours)
        if state == "foreign":
            _refuse_foreign(os.path.join(EXTENSION_DIR, EXTENSION_NAME))
        if existing == data:
            return
        d.atomic_write(EXTENSION_NAME, data, 0o644)
    finally:
        d.close()


def remove_nautilus_extension() -> None:
    d = open_state_dir(rel_to_home(EXTENSION_DIR))
    if d is None:
        return
    try:
        state, _ = inspect_registration(d, EXTENSION_NAME, EXTENSION_CAP, extension_is_ours)
        if state == "foreign":
            print(
                f"{APP}: leaving {os.path.join(EXTENSION_DIR, EXTENSION_NAME)} in place: "
                "it was not installed by Fast Fruit Drive",
                file=sys.stderr,
            )
            return
        d.unlink(EXTENSION_NAME)
        try:
            pycache = d.enter("__pycache__")
        except (FileNotFoundError, Unsafe):
            return
        try:
            for entry in list(pycache.scandir_names()):
                if entry.name.startswith("fast_fruit_drive_nautilus"):
                    pycache.unlink(entry.name)
        finally:
            pycache.close()
    finally:
        d.close()


# =======================================================================
# Pending-upload protection
#
# clear-cache and uninstall both delete the local VFS cache. rclone tracks
# not-yet-uploaded writes in vfsMeta/<remote>/... with "Dirty": true; that
# state must never be deleted before the upload finishes. The scan below
# is descriptor-relative and bounded (depth, entry count, per-file size),
# exactly like every other tree walk in this file.
# =======================================================================

MAX_META_ENTRIES = 200_000
MAX_META_DEPTH = 64
MAX_META_FILE = 262_144


def _scan_dirty(d: SafeDir, depth: int, counter: list) -> bool:
    if depth > MAX_META_DEPTH:
        raise Unsafe("cache metadata tree too deep")
    for entry in d.scandir_names():
        counter[0] += 1
        if counter[0] > MAX_META_ENTRIES:
            raise Unsafe("cache metadata tree too large")
        if entry.is_dir(follow_symlinks=False):
            child = d.enter(entry.name)
            try:
                if _scan_dirty(child, depth + 1, counter):
                    return True
            finally:
                child.close()
            continue
        if not entry.is_file(follow_symlinks=False):
            continue
        try:
            data = d.read_bounded(entry.name, MAX_META_FILE, missing_ok=True)
        except Unsafe:
            continue
        if not data:
            continue
        try:
            obj = json.loads(data)
        except ValueError:
            continue
        if isinstance(obj, dict) and obj.get("Dirty") is True:
            return True
    return False


def cache_has_dirty_uploads() -> bool:
    cache = open_state_dir(rel_to_home(CACHE_DIR))
    if cache is None:
        return False
    try:
        try:
            meta_root = cache.enter("vfsMeta")
        except (FileNotFoundError, Unsafe):
            return False
        try:
            return _scan_dirty(meta_root, 0, [0])
        finally:
            meta_root.close()
    finally:
        cache.close()


def cache_bytes() -> int:
    total = 0
    cache = open_state_dir(rel_to_home(CACHE_DIR))
    if cache is None:
        return 0
    try:
        stack = [cache]
        opened_extra = []
        while stack:
            cur = stack.pop()
            for entry in cur.scandir_names():
                try:
                    if entry.is_dir(follow_symlinks=False):
                        child = cur.enter(entry.name)
                        opened_extra.append(child)
                        stack.append(child)
                    elif entry.is_file(follow_symlinks=False):
                        total += entry.stat(follow_symlinks=False).st_size
                except (OSError, Unsafe):
                    continue
        for d in opened_extra:
            d.close()
    finally:
        cache.close()
    return total


# =======================================================================
# systemctl / gio helpers
# =======================================================================

def service_unit_owned() -> bool:
    """Whether the user-level service unit at UNIT_NAME is one we wrote.

    Runtime control (status, start, stop, restart) is only meaningful for our
    own unit. A same-named unit from anything else is never queried as if it
    were ours and never stopped or restarted on our behalf.
    """
    d = open_state_dir(rel_to_home(UNIT_DIR))
    if d is None:
        return False
    try:
        return inspect_registration(d, UNIT_NAME, UNIT_CAP, _unit_predicate(UNIT_NAME))[0] == "ours"
    finally:
        d.close()


def service_main_pid() -> "int | None":
    if not Tools.systemctl or not service_unit_owned():
        return None
    result = run_bounded([Tools.systemctl, "--user", "show", "-p", "MainPID", "--value", UNIT_NAME], timeout=5)
    if not result.ok:
        return None
    text = result.stdout.decode("ascii", "replace").strip()
    if not text.isdigit():
        return None
    pid = int(text)
    return pid if pid > 1 else None


def service_running() -> bool:
    if not Tools.systemctl or not service_unit_owned():
        return False
    result = run_bounded([Tools.systemctl, "--user", "is-active", "--quiet", UNIT_NAME], timeout=5)
    return result.returncode == 0 and not result.timed_out


_MUTATING_VERBS = frozenset({"start", "stop", "restart", "reload", "try-restart", "kill"})


def systemctl(*args: str, timeout: float = 20) -> BoundedResult:
    if not Tools.systemctl:
        fail("systemctl not found")
    if args and args[0] in _MUTATING_VERBS and UNIT_NAME in args and not service_unit_owned():
        note = f"not touching {UNIT_NAME}: the user unit of that name was not installed by Fast Fruit Drive"
        print(f"{APP}: {note}", file=sys.stderr)
        return BoundedResult(1, b"", note.encode("utf-8"))
    return run_bounded([Tools.systemctl, "--user", *args], timeout=timeout)


def gio_mounted() -> bool:
    if not Tools.gio:
        return False
    result = run_bounded([Tools.gio, "mount", "-l"], timeout=5)
    return DAV_URI in result.stdout.decode("utf-8", "replace")


def label_mount() -> None:
    if not Tools.gio:
        return
    run_bounded([Tools.gio, "set", "-t", "string", DAV_URI, "metadata::display-name", DISPLAY_NAME], timeout=5)


def unmount_legacy_dav() -> None:
    if not Tools.gio:
        return
    for uri in (LEGACY_URI_NO_USER, LEGACY_URI_OLD_HOST_AUTH, LEGACY_URI_OLD_HOST):
        run_bounded([Tools.gio, "mount", "-u", uri], timeout=5)


def unmount_dav() -> None:
    if not Tools.gio:
        return
    run_bounded([Tools.gio, "mount", "-u", DAV_URI], timeout=5)
    unmount_legacy_dav()


# =======================================================================
# Commands
# =======================================================================

def require_packages() -> None:
    need_rclone = not Tools.rclone
    need_gvfs = not (os.path.isfile("/usr/lib/gvfsd-dav") and os.access("/usr/lib/gvfsd-dav", os.X_OK))
    if not need_rclone and not need_gvfs:
        return
    lines = [f"{APP}: required packages missing. Run: omarchy pkg add gvfs-dnssd rclone"]
    if need_rclone:
        lines.append("  - rclone \u2014 serves iCloud over WebDAV")
    if need_gvfs:
        lines.append("  - gvfs-dnssd \u2014 the Nautilus WebDAV backend")
    lines.append("Then toggle Fast Fruit Drive on again.")
    print("\n".join(lines), file=sys.stderr)
    raise SystemExit(1)


def cmd_ensure(_args) -> None:
    require_packages()
    # Refuse up front, before any state is written, if a fixed-name unit or
    # extension belongs to something else.
    check_registration_ownership()
    cfg = load_config()
    save_config(cfg)
    # ReadWritePaths= in the unit below needs this directory to already
    # exist: systemd sets up the bind mount before ExecStart runs, and
    # ProtectHome=read-only would otherwise leave a fresh install with no
    # way to create it from inside the sandboxed service.
    ensure_state_dir(rel_to_home(CACHE_DIR)).close()
    install_lifecycle_guard()
    ensure_webdav_auth()
    write_unit()
    ensure_bookmark()
    install_nautilus_extension()


def cmd_migrate_lifecycle(_args) -> None:
    """Bootstrap the guard when an existing pre-0.2.1 unit is present.

    The widget controller starts this private, non-persistent command as soon
    as the updated plugin is loaded. It does not create or enable the main
    service, bookmark, or extension for a plugin that has never been started.
    If an old unit exists,
    it atomically replaces only that registration so a subsequent restart (or
    removal cleanup) cannot execute checkout content directly.
    """
    install_lifecycle_guard()
    d = open_state_dir(rel_to_home(UNIT_DIR))
    if d is None:
        return
    try:
        state, _ = inspect_registration(d, UNIT_NAME, UNIT_CAP, _unit_predicate(UNIT_NAME))
    finally:
        d.close()
    if state == "foreign":
        print(
            f"{APP}: not migrating {os.path.join(UNIT_DIR, UNIT_NAME)}: "
            "it was not installed by Fast Fruit Drive",
            file=sys.stderr,
        )
        return
    if state == "ours":
        write_unit(enable=False)


def cmd_serve(_args) -> None:
    cfg = load_config()
    if not Tools.rclone:
        fail("rclone not found")
    if not remote_configured():
        fail(f"rclone remote '{REMOTE}' is not configured")
    ensure_state_dir(rel_to_home(CACHE_DIR)).close()
    # Open the config dir with a fd that survives the coming execve, so
    # rclone can be handed "/proc/self/fd/N/webdav.htpasswd" — a path that
    # cannot be swapped later because it resolves through the retained
    # open directory description, not by re-walking a pathname.
    authdir = ensure_state_dir(rel_to_home(CONFIG_DIR))
    os.set_inheritable(authdir.fd, True)
    try:
        validate_webdav_auth(authdir)
    except AuthError as exc:
        fail(str(exc))
    args = [
        Tools.rclone, "serve", "webdav", REMOTE,
        "--addr", f"{BIND_V4}:{PORT}",
        "--addr", f"[{BIND_V6}]:{PORT}",
        "--vfs-cache-mode", VFS_CACHE_MODE,
        "--vfs-cache-max-size", cfg.cache_max_size,
        "--vfs-cache-max-age", cfg.cache_max_age,
        "--vfs-read-ahead", "0",
        "--poll-interval", "0",
        "--dir-cache-time", "30s",
        # iCloud gives folders no modified date, and rclone would show its
        # placeholder (2000-01-01) as if it were real. Nautilus treats a
        # modified time of exactly 0 as unknown and leaves it blank.
        "--default-time", UNKNOWN_MODTIME,
        "--cache-dir", CACHE_DIR,
        "--htpasswd", f"/proc/self/fd/{authdir.fd}/{WEBDAV_HTPASSWD_FILE}",
    ]
    os.execve(Tools.rclone, args, sanitized_child_env())


def wait_for_server() -> None:
    pid = service_main_pid()
    if pid is None:
        fail("service MainPID unavailable")
    if not Tools.rclone:
        fail("rclone not found")
    wait_webdav_ready(pid, Tools.rclone)


def do_mount() -> None:
    pid = service_main_pid()
    if pid is None:
        fail("service MainPID unavailable")
    if not Tools.rclone:
        fail("rclone not found")
    unmount_legacy_dav()
    mount_dav(pid, Tools.rclone)
    label_mount()


def cmd_start(_args) -> None:
    cmd_ensure(_args)
    if not remote_configured():
        fail(f"rclone remote '{REMOTE}' is not configured \u2014 use Sign in on the widget")
    require_valid_session()
    systemctl("start", UNIT_NAME)
    if not service_running():
        fail(f"service failed to start \u2014 see: journalctl --user -u {UNIT_NAME}")
    wait_for_server()
    do_mount()
    ensure_bookmark()


def cmd_stop(_args) -> None:
    unmount_dav()
    systemctl("stop", UNIT_NAME, timeout=20)
    remove_bookmark()


def _guard_no_dirty(action: str) -> bool:
    """Stop the service, refuse if pending uploads exist (restarting the
    service first), otherwise leave it stopped. Returns whether it was
    running before this call."""
    was_running = service_running()
    if was_running:
        systemctl("stop", UNIT_NAME, timeout=20)
    if cache_has_dirty_uploads():
        if was_running:
            systemctl("start", UNIT_NAME, timeout=20)
        fail(f"pending uploads remain in the local cache \u2014 wait for them to finish, then {action} again")
    return was_running


def cmd_restart(_args) -> None:
    cmd_ensure(_args)
    require_valid_session()
    systemctl("restart", UNIT_NAME)
    wait_for_server()
    do_mount()
    ensure_bookmark()


def cmd_toggle(args) -> None:
    if service_running():
        cmd_stop(args)
    else:
        cmd_start(args)


def cmd_open(_args) -> None:
    load_config()
    if fresh_session_state() in ("missing",) + BAD_SESSION_STATES:
        # Nothing useful to show in Nautilus: it would only offer a password
        # prompt. Take the user straight to the sign-in instead.
        print(f"{APP}: iCloud sign-in needed \u2014 opening the sign-in terminal", file=sys.stderr)
        cmd_login(_args)
        return
    if Tools.omarchy:
        spawn_detached([Tools.omarchy, "launch", "nautilus"])
    elif Tools.nautilus:
        spawn_detached([Tools.nautilus, "--new-window"])
    else:
        fail("nautilus not found")
    if not service_running():
        cmd_start(_args)
        return
    do_mount()
    ensure_bookmark()


def cmd_mount(_args) -> None:
    """Re-establish the GVFS mount behind the Nautilus sidebar bookmark.

    GVFS mounts die with the desktop session, so right after a reboot the
    server is up but nothing has mounted it yet: a direct sidebar click
    would otherwise hit the authenticated 401 and show a password prompt
    for a credential the user is never meant to see. The widget calls this
    when it observes running && !mounted. Mounting never starts the server:
    only `start`/`toggle`/`open` may do that.
    """
    if not service_running():
        fail("Fast Fruit Drive is not running \u2014 toggle it on from the bar")
    require_valid_session()
    wait_for_server()
    do_mount()
    ensure_bookmark()


def cmd_login(_args) -> None:
    if Tools.omarchy:
        spawn_detached([Tools.omarchy, "launch", "tui",
                         "--app-id=io.github.abort-retry-ignore.ff-drive-login",
                         Tools.python3 or sys.executable, "-I", SELF_PATH, "login-tui"])
        return
    if Tools.xdg_terminal:
        spawn_detached([Tools.xdg_terminal, "-e", Tools.python3 or sys.executable, "-I", SELF_PATH, "login-tui"])
        return
    fail(f"open a terminal and run: {SELF_PATH} login-tui")


def cmd_login_tui(_args) -> None:
    if not Tools.rclone:
        fail("rclone not found")
    print()
    print("Fast Fruit Drive \u2014 iCloud sign-in")
    print()
    print("rclone stores a trust token in ~/.config/rclone/rclone.conf (not in this plugin).")
    print("The token lasts about 30 days. After that, run Sign in again.")
    print("Use your real Apple ID password + 2FA. App-specific passwords are rejected.")
    print()
    if remote_configured():
        print(f"Reconnecting existing remote: {REMOTE}")
        print()
        subprocess.run([Tools.rclone, "config", "reconnect", REMOTE], env=sanitized_child_env())
    else:
        print(f"No '{REMOTE}' remote yet. In the rclone wizard:")
        print("  n) New remote")
        print(f"  name> {REMOTE_NAME}")
        print("  Storage> iclouddrive")
        print()
        subprocess.run([Tools.rclone, "config"], env=sanitized_child_env())
    print()
    print("Checking the new session with iCloud...")
    # Apple can still be issuing cookies right after sign-in, so an
    # inconclusive probe ("unknown") is retried before giving up on it. The
    # terminal explains any problem itself, so no desktop notification here.
    state = fresh_session_state(notify=False)
    for _ in range(3):
        if state != "unknown":
            break
        time.sleep(3)
        state = fresh_session_state(notify=False)
    if state == "pcs":
        print("Apple signed you in but did not issue the cookies iCloud Drive needs")
        print("(rclone: 'Missing X-APPLE-WEBAUTH-TOKEN cookie', rclone issue #9658).")
        print("Known causes, most common first:")
        print()
        print("  1. iCloud Terms & Conditions are waiting for you. Open https://www.icloud.com")
        print("     in a browser, sign in, and click Agree on any Terms dialog.")
        print("  2. 'Access iCloud Data on the Web' is off (Settings > Apple Account > iCloud on")
        print("     your iPhone; Advanced Data Protection turns it off).")
        print("  3. A trusted-device prompt was not approved while signing in.")
        print()
        print("Then run Sign in again from the widget.")
        print()
        print("If it keeps failing, clear 'cookies' and 'trust_token' from the [icloud]")
        print("section of ~/.config/rclone/rclone.conf, then Sign in again.")
        print()
        return
    if state in ("expired", "missing"):
        print("iCloud still rejects the session. Close this window and use Sign in again.")
        print()
        return
    if service_running():
        # The running server holds the old session in memory: restart it so
        # it picks up the new token, then restore the Nautilus mount.
        print("Restarting the WebDAV service with the new session...")
        try:
            systemctl("restart", UNIT_NAME)
            wait_for_server()
            do_mount()
            ensure_bookmark()
        except SystemExit:
            print("Could not restart automatically; toggle Fast Fruit Drive off and on from the bar.")
            print()
            return
        print()
        print("Done. You can close this terminal.")
    else:
        # Signing in is a request to use the drive: turn it on and mount it.
        print("Starting Fast Fruit Drive...")
        try:
            cmd_start([])
        except SystemExit:
            print("Signed in, but it could not start automatically; toggle Fast Fruit Drive on from the bar.")
            print()
            return
        print()
        print("Done. Fast Fruit Drive is on. You can close this terminal.")
    print()


def cmd_configure(args) -> None:
    cfg = load_config()
    restart = False
    changed = False
    for pair in args:
        key, _, value = pair.partition("=")
        if key == "cache_max_size":
            if not valid_cache_size(value):
                fail(f"invalid cache_max_size: {value}")
            changed = changed or value != cfg.cache_max_size
            cfg.cache_max_size = value
        elif key == "cache_max_age_hours":
            if not valid_cache_age_hours(value):
                fail(f"invalid cache_max_age_hours: {value}")
            changed = changed or int(value) != cfg.cache_max_age_hours
            cfg.cache_max_age_hours = int(value)
        elif key == "restart":
            restart = bool_value(value)
        else:
            fail(f"unknown configure key: {key}")
    save_config(cfg)
    running = service_running()
    if restart and changed and running:
        cmd_restart(args)
    elif running:
        ensure_bookmark()
    # A stopped drive gets no bookmark: the widget runs `configure` on every
    # load to apply its settings, and a sidebar entry for a server that is not
    # there is a dead link.


def cmd_clear_cache(_args) -> None:
    freed = cache_bytes()
    was_running = _guard_no_dirty("clear-cache")
    home = open_home()
    try:
        home.remove_tree(rel_to_home(CACHE_DIR))
    except (Unsafe, OSError) as exc:
        if was_running:
            systemctl("start", UNIT_NAME, timeout=20)
        fail(f"refusing to clear unsafe cache path: {exc}")
    finally:
        home.close()
    ensure_state_dir(rel_to_home(CACHE_DIR)).close()
    if was_running:
        systemctl("start", UNIT_NAME, timeout=20)
        wait_for_server()
    freed_text = _format_bytes(freed)
    print(f"Cache cleared: {freed_text} freed from {CACHE_DIR}")


def _format_bytes(n: int) -> str:
    value = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if value < 1000 or unit == "TB":
            return f"{value:.0f}{unit}" if unit == "B" else f"{value:.1f}{unit}"
        value /= 1000
    return f"{value:.1f}TB"


def remove_unit_registrations() -> None:
    """Disable, stop and delete only the units this installation wrote.

    Foreign files at the same names are reported and left alone, and their
    systemd state (enabled, active, failed) is never touched.
    """
    d = open_state_dir(rel_to_home(UNIT_DIR))
    if d is None:
        return
    try:
        owned = []
        for name in UNIT_FILES:
            state, _ = inspect_registration(d, name, UNIT_CAP, _unit_predicate(name))
            if state == "ours":
                owned.append(name)
            elif state == "foreign":
                print(
                    f"{APP}: leaving {os.path.join(UNIT_DIR, name)} in place: "
                    "it was not installed by Fast Fruit Drive",
                    file=sys.stderr,
                )
        if not owned:
            return
        enabled = [name for name in ENABLED_UNITS if name in owned]
        if Tools.systemctl and enabled:
            run_bounded([Tools.systemctl, "--user", "disable", "--now", *enabled], timeout=20)
        for name in owned:
            # Re-check through the same pinned descriptor right before deleting.
            if inspect_registration(d, name, UNIT_CAP, _unit_predicate(name))[0] == "ours":
                d.unlink(name)
    finally:
        d.close()
    wants = open_state_dir(rel_to_home(WANTS_DIR))
    if wants is not None:
        try:
            for name in enabled:
                # Only the enablement symlink pointing at our unit file.
                wants.unlink_symlink_to(name, {os.path.join(UNIT_DIR, name), "../" + name})
        finally:
            wants.close()
    if Tools.systemctl:
        if UNIT_NAME in owned:
            run_bounded([Tools.systemctl, "--user", "reset-failed", UNIT_NAME], timeout=10)
        run_bounded([Tools.systemctl, "--user", "daemon-reload"], timeout=10)


def cmd_uninstall(_args) -> None:
    was_running = _guard_no_dirty("uninstall")
    unmount_dav()
    remove_unit_registrations()
    remove_bookmark()
    remove_nautilus_extension()
    home = open_home()
    try:
        try:
            home.remove_tree(rel_to_home(CONFIG_DIR))
        except (Unsafe, OSError) as exc:
            print(f"{APP}: refusing to delete unsafe path: {CONFIG_DIR} ({exc})", file=sys.stderr)
        try:
            home.remove_tree(rel_to_home(CACHE_DIR))
        except (Unsafe, OSError) as exc:
            print(f"{APP}: refusing to delete unsafe path: {CACHE_DIR} ({exc})", file=sys.stderr)
    finally:
        home.close()
    print(f"{APP}: removed unit, bookmark, emblems, {CONFIG_DIR}, and {CACHE_DIR}")
    print(f"{APP}: left ~/.config/rclone/rclone.conf untouched (Apple session is rclone's)")
    _ = was_running  # already stopped; nothing left to restart


def cmd_status(_args) -> None:
    cfg = load_config()
    rclone_found = bool(Tools.rclone)
    configured = rclone_found and remote_configured()
    has_session = configured and session_present()
    running = service_running()
    # Presence of a token is not validity: ask the (cached, background-probed)
    # verdict about whether iCloud still accepts it.
    problem = cached_session_state(allow_probe=running) if has_session else "unknown"
    expired = problem in BAD_SESSION_STATES
    mounted = gio_mounted()
    gvfs = os.path.isfile("/usr/lib/gvfsd-dav") and os.access("/usr/lib/gvfsd-dav", os.X_OK)
    used = cache_bytes()

    ready = rclone_found and configured and has_session and not expired and gvfs
    needs_login = rclone_found and (not configured or not has_session or expired)

    status_text = "Stopped"
    if not rclone_found:
        status_text = "rclone not found"
    elif problem == "pcs":
        status_text = "iCloud sign-in incomplete"
    elif expired:
        status_text = "iCloud session expired"
    elif needs_login:
        status_text = "Sign in to iCloud"
    elif not gvfs:
        status_text = "install gvfs-dnssd"
    elif running:
        status_text = "Connected" if mounted else "Serving"

    payload = {
        "ok": True,
        "ready": ready,
        "running": running,
        "mounted": mounted,
        "rcloneFound": rclone_found,
        "remoteConfigured": configured,
        "hasSession": has_session,
        "sessionExpired": expired,
        "sessionProblem": problem if expired else "",
        "needsLogin": needs_login,
        "gvfsDav": gvfs,
        "cacheUsedBytes": used,
        "statusText": status_text,
        "remote": REMOTE,
        "addr": f"{BIND_V4}:{PORT}",
        "uri": DAV_URI,
        "displayName": DISPLAY_NAME,
        "cacheMaxSize": cfg.cache_max_size,
        "cacheMaxAge": cfg.cache_max_age,
        "cachePath": CACHE_DIR,
        "lastError": "",
    }
    print(json.dumps(payload))


USAGE = f"""Usage: {APP} <command> [args]

Commands:
  status                         JSON status for the bar widget
  start                          Start WebDAV, mount, bookmark as iCloud Drive
  stop                           Stop WebDAV and unmount
  restart                        Restart the user service
  toggle                         Start if stopped, stop if running
  open                           Start if needed and open in Nautilus
  mount                          Re-mount the running server for the
                                  Nautilus sidebar (never starts the server)
  login                          Open a terminal for iCloud sign-in / reconnect
  login-tui                      Interactive rclone reconnect (run inside a terminal)
  serve                          Exec rclone (systemd ExecStart)
  ensure                         Write unit, config, and Nautilus bookmark
  configure KEY=VAL [...]        Update config; add restart=1 to bounce rclone
  clear-cache                    Bounce rclone and wipe the local file cache
                                  (refuses while uploads are still pending)
  uninstall                      Stop and delete unit, bookmark, emblems, config, cache
                                  (refuses while uploads are still pending)
  help                           Show this help
"""


def cmd_help(_args) -> None:
    print(USAGE, end="")


def cmd_supervise(args) -> None:
    """QML entry point: run COMMAND ARGS... as an isolated child, capping
    its raw stdout/stderr in bytes *before* any line parsing happens, and
    enforcing a hard wall-clock deadline. Never used for `serve` (the
    long-running systemd service) or `login-tui` (an interactive session)."""
    if len(args) < 2:
        fail("usage: __supervise TIMEOUT COMMAND [ARGS...]")
    try:
        timeout = float(args[0])
    except ValueError:
        fail("invalid supervise timeout")
    command = args[1]
    if command not in SUPERVISABLE_COMMANDS:
        fail(f"refusing to supervise command: {command}")
    python3 = Tools.python3 or find_verified("python3")
    if not python3:
        fail("python3 not found")
    child_argv = [python3, "-I", SELF_PATH, command, *args[2:]]
    result = run_bounded(child_argv, timeout=timeout, cap=OUTPUT_CAP)
    sys.stdout.buffer.write(result.stdout)
    sys.stderr.buffer.write(result.stderr)
    if result.timed_out:
        sys.stderr.write(f"\n{APP}: command timed out after {timeout:g}s\n")
        raise SystemExit(124)
    if result.overflowed:
        sys.stderr.write(f"\n{APP}: command output exceeded {OUTPUT_CAP} bytes\n")
        raise SystemExit(125)
    raise SystemExit(result.returncode)


COMMANDS = {
    "status": cmd_status,
    "start": cmd_start,
    "stop": cmd_stop,
    "restart": cmd_restart,
    "toggle": cmd_toggle,
    "open": cmd_open,
    "mount": cmd_mount,
    "login": cmd_login,
    "login-tui": cmd_login_tui,
    "serve": cmd_serve,
    "ensure": cmd_ensure,
    "configure": cmd_configure,
    "clear-cache": cmd_clear_cache,
    "uninstall": cmd_uninstall,
    "__migrate-lifecycle": cmd_migrate_lifecycle,
    "__check-session": cmd_check_session,
    "help": cmd_help,
}


def main(argv: "list[str]") -> None:
    command = argv[0] if argv else "help"
    rest = argv[1:]
    if command == "__supervise":
        resolve_tools()
        cmd_supervise(rest)
        return
    if command not in COMMANDS:
        fail(f"unknown command: {command}")
    if command == "serve":
        global _EXTRA_TRUSTED_UIDS
        _EXTRA_TRUSTED_UIDS = frozenset({_overflow_uid()})
    if command != "help":
        resolve_tools()
    COMMANDS[command](rest)


if __name__ == "__main__":
    main(sys.argv[1:])
